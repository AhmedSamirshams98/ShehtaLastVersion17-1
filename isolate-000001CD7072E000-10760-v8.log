script-source,312,node:internal/http2/compat,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  Boolean\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectHasOwn\x2C\x0d\n  ObjectKeys\x2C\x0d\n  Proxy\x2C\x0d\n  ReflectApply\x2C\x0d\n  ReflectGetPrototypeOf\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst assert = require('internal/assert');\x0d\nconst Stream = require('stream');\x0d\nconst { Readable } = Stream;\x0d\nconst {\x0d\n  constants: {\x0d\n    HTTP2_HEADER_AUTHORITY\x2C\x0d\n    HTTP2_HEADER_CONNECTION\x2C\x0d\n    HTTP2_HEADER_METHOD\x2C\x0d\n    HTTP2_HEADER_PATH\x2C\x0d\n    HTTP2_HEADER_SCHEME\x2C\x0d\n    HTTP2_HEADER_STATUS\x2C\x0d\n\x0d\n    HTTP_STATUS_CONTINUE\x2C\x0d\n    HTTP_STATUS_EARLY_HINTS\x2C\x0d\n    HTTP_STATUS_EXPECTATION_FAILED\x2C\x0d\n    HTTP_STATUS_METHOD_NOT_ALLOWED\x2C\x0d\n    HTTP_STATUS_OK\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('http2');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_HTTP2_HEADERS_SENT\x2C\x0d\n    ERR_HTTP2_INFO_STATUS_NOT_ALLOWED\x2C\x0d\n    ERR_HTTP2_INVALID_HEADER_VALUE\x2C\x0d\n    ERR_HTTP2_INVALID_STREAM\x2C\x0d\n    ERR_HTTP2_NO_SOCKET_MANIPULATION\x2C\x0d\n    ERR_HTTP2_PSEUDOHEADER_NOT_ALLOWED\x2C\x0d\n    ERR_HTTP2_STATUS_INVALID\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_HTTP_TOKEN\x2C\x0d\n    ERR_STREAM_WRITE_AFTER_END\x2C\x0d\n  }\x2C\x0d\n  hideStackFrames\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  validateFunction\x2C\x0d\n  validateString\x2C\x0d\n  validateLinkHeaderValue\x2C\x0d\n  validateObject\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  kSocket\x2C\x0d\n  kRequest\x2C\x0d\n  kProxySocket\x2C\x0d\n  assertValidPseudoHeader\x2C\x0d\n  getAuthority\x2C\x0d\n} = require('internal/http2/util');\x0d\nconst { _checkIsHttpToken: checkIsHttpToken } = require('_http_common');\x0d\n\x0d\nconst kBeginSend = Symbol('begin-send');\x0d\nconst kState = Symbol('state');\x0d\nconst kStream = Symbol('stream');\x0d\nconst kResponse = Symbol('response');\x0d\nconst kHeaders = Symbol('headers');\x0d\nconst kRawHeaders = Symbol('rawHeaders');\x0d\nconst kTrailers = Symbol('trailers');\x0d\nconst kRawTrailers = Symbol('rawTrailers');\x0d\nconst kSetHeader = Symbol('setHeader');\x0d\nconst kAppendHeader = Symbol('appendHeader');\x0d\nconst kAborted = Symbol('aborted');\x0d\n\x0d\nlet statusMessageWarned = false;\x0d\nlet statusConnectionHeaderWarned = false;\x0d\n\x0d\n// Defines and implements an API compatibility layer on top of the core\x0d\n// HTTP/2 implementation\x2C intended to provide an interface that is as\x0d\n// close as possible to the current require('http') API\x0d\n\x0d\nconst assertValidHeader = hideStackFrames((name\x2C value) => {\x0d\n  if (name === '' ||\x0d\n      typeof name !== 'string' ||\x0d\n      name.includes(' ')) {\x0d\n    throw new ERR_INVALID_HTTP_TOKEN.HideStackFramesError('Header name'\x2C name);\x0d\n  }\x0d\n  if (isPseudoHeader(name)) {\x0d\n    throw new ERR_HTTP2_PSEUDOHEADER_NOT_ALLOWED.HideStackFramesError();\x0d\n  }\x0d\n  if (value === undefined || value === null) {\x0d\n    throw new ERR_HTTP2_INVALID_HEADER_VALUE.HideStackFramesError(value\x2C name);\x0d\n  }\x0d\n  if (!isConnectionHeaderAllowed(name\x2C value)) {\x0d\n    connectionHeaderMessageWarn();\x0d\n  }\x0d\n});\x0d\n\x0d\nfunction isPseudoHeader(name) {\x0d\n  switch (name) {\x0d\n    case HTTP2_HEADER_STATUS:    // :status\x0d\n    case HTTP2_HEADER_METHOD:    // :method\x0d\n    case HTTP2_HEADER_PATH:      // :path\x0d\n    case HTTP2_HEADER_AUTHORITY: // :authority\x0d\n    case HTTP2_HEADER_SCHEME:    // :scheme\x0d\n      return true;\x0d\n    default:\x0d\n      return false;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction statusMessageWarn() {\x0d\n  if (statusMessageWarned === false) {\x0d\n    process.emitWarning(\x0d\n      'Status message is not supported by HTTP/2 (RFC7540 8.1.2.4)'\x2C\x0d\n      'UnsupportedWarning'\x2C\x0d\n    );\x0d\n    statusMessageWarned = true;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction isConnectionHeaderAllowed(name\x2C value) {\x0d\n  return name !== HTTP2_HEADER_CONNECTION ||\x0d\n         value === 'trailers';\x0d\n}\x0d\n\x0d\nfunction connectionHeaderMessageWarn() {\x0d\n  if (statusConnectionHeaderWarned === false) {\x0d\n    process.emitWarning(\x0d\n      'The provided connection header is not valid\x2C ' +\x0d\n      'the value will be dropped from the header and ' +\x0d\n      'will never be in use.'\x2C\x0d\n      'UnsupportedWarning'\x2C\x0d\n    );\x0d\n    statusConnectionHeaderWarned = true;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStreamData(chunk) {\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined && !request.push(chunk))\x0d\n    this.pause();\x0d\n}\x0d\n\x0d\nfunction onStreamTrailers(trailers\x2C flags\x2C rawTrailers) {\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined) {\x0d\n    ObjectAssign(request[kTrailers]\x2C trailers);\x0d\n    request[kRawTrailers].push(...rawTrailers);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStreamEnd() {\x0d\n  // Cause the request stream to end as well.\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined)\x0d\n    this[kRequest].push(null);\x0d\n}\x0d\n\x0d\nfunction onStreamError(error) {\x0d\n  // This is purposefully left blank\x0d\n  //\x0d\n  // errors in compatibility mode are\x0d\n  // not forwarded to the request\x0d\n  // and response objects.\x0d\n}\x0d\n\x0d\nfunction onRequestPause() {\x0d\n  this[kStream].pause();\x0d\n}\x0d\n\x0d\nfunction onRequestResume() {\x0d\n  this[kStream].resume();\x0d\n}\x0d\n\x0d\nfunction onStreamDrain() {\x0d\n  const response = this[kResponse];\x0d\n  if (response !== undefined)\x0d\n    response.emit('drain');\x0d\n}\x0d\n\x0d\nfunction onStreamAbortedRequest() {\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined && request[kState].closed === false) {\x0d\n    request[kAborted] = true;\x0d\n    request.emit('aborted');\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStreamAbortedResponse() {\x0d\n  // non-op for now\x0d\n}\x0d\n\x0d\nfunction resumeStream(stream) {\x0d\n  stream.resume();\x0d\n}\x0d\n\x0d\nconst proxySocketHandler = {\x0d\n  has(stream\x2C prop) {\x0d\n    const ref = stream.session !== undefined ? stream.session[kSocket] : stream;\x0d\n    return (prop in stream) || (prop in ref);\x0d\n  }\x2C\x0d\n\x0d\n  get(stream\x2C prop) {\x0d\n    switch (prop) {\x0d\n      case 'on':\x0d\n      case 'once':\x0d\n      case 'end':\x0d\n      case 'emit':\x0d\n      case 'destroy':\x0d\n        return stream[prop].bind(stream);\x0d\n      case 'writable':\x0d\n      case 'destroyed':\x0d\n        return stream[prop];\x0d\n      case 'readable': {\x0d\n        if (stream.destroyed)\x0d\n          return false;\x0d\n        const request = stream[kRequest];\x0d\n        return request ? request.readable : stream.readable;\x0d\n      }\x0d\n      case 'setTimeout': {\x0d\n        const session = stream.session;\x0d\n        if (session !== undefined)\x0d\n          return session.setTimeout.bind(session);\x0d\n        return stream.setTimeout.bind(stream);\x0d\n      }\x0d\n      case 'write':\x0d\n      case 'read':\x0d\n      case 'pause':\x0d\n      case 'resume':\x0d\n        throw new ERR_HTTP2_NO_SOCKET_MANIPULATION();\x0d\n      default: {\x0d\n        const ref = stream.session !== undefined ?\x0d\n          stream.session[kSocket] : stream;\x0d\n        const value = ref[prop];\x0d\n        return typeof value === 'function' ?\x0d\n          value.bind(ref) :\x0d\n          value;\x0d\n      }\x0d\n    }\x0d\n  }\x2C\x0d\n  getPrototypeOf(stream) {\x0d\n    if (stream.session !== undefined)\x0d\n      return ReflectGetPrototypeOf(stream.session[kSocket]);\x0d\n    return ReflectGetPrototypeOf(stream);\x0d\n  }\x2C\x0d\n  set(stream\x2C prop\x2C value) {\x0d\n    switch (prop) {\x0d\n      case 'writable':\x0d\n      case 'readable':\x0d\n      case 'destroyed':\x0d\n      case 'on':\x0d\n      case 'once':\x0d\n      case 'end':\x0d\n      case 'emit':\x0d\n      case 'destroy':\x0d\n        stream[prop] = value;\x0d\n        return true;\x0d\n      case 'setTimeout': {\x0d\n        const session = stream.session;\x0d\n        if (session !== undefined)\x0d\n          session.setTimeout = value;\x0d\n        else\x0d\n          stream.setTimeout = value;\x0d\n        return true;\x0d\n      }\x0d\n      case 'write':\x0d\n      case 'read':\x0d\n      case 'pause':\x0d\n      case 'resume':\x0d\n        throw new ERR_HTTP2_NO_SOCKET_MANIPULATION();\x0d\n      default: {\x0d\n        const ref = stream.session !== undefined ?\x0d\n          stream.session[kSocket] : stream;\x0d\n        ref[prop] = value;\x0d\n        return true;\x0d\n      }\x0d\n    }\x0d\n  }\x2C\x0d\n};\x0d\n\x0d\nfunction onStreamCloseRequest() {\x0d\n  const req = this[kRequest];\x0d\n\x0d\n  if (req === undefined)\x0d\n    return;\x0d\n\x0d\n  const state = req[kState];\x0d\n  state.closed = true;\x0d\n\x0d\n  req.push(null);\x0d\n  // If the user didn't interact with incoming data and didn't pipe it\x2C\x0d\n  // dump it for compatibility with http1\x0d\n  if (!state.didRead && !req._readableState.resumeScheduled)\x0d\n    req.resume();\x0d\n\x0d\n  this[kProxySocket] = null;\x0d\n  this[kRequest] = undefined;\x0d\n\x0d\n  req.emit('close');\x0d\n}\x0d\n\x0d\nfunction onStreamTimeout(kind) {\x0d\n  return function onStreamTimeout() {\x0d\n    const obj = this[kind];\x0d\n    obj.emit('timeout');\x0d\n  };\x0d\n}\x0d\n\x0d\nclass Http2ServerRequest extends Readable {\x0d\n  constructor(stream\x2C headers\x2C options\x2C rawHeaders) {\x0d\n    super({ autoDestroy: false\x2C ...options });\x0d\n    this[kState] = {\x0d\n      closed: false\x2C\x0d\n      didRead: false\x2C\x0d\n    };\x0d\n    // Headers in HTTP/1 are not initialized using Object.create(null) which\x2C\x0d\n    // although preferable\x2C would simply break too much code. Ergo header\x0d\n    // initialization using Object.create(null) in HTTP/2 is intentional.\x0d\n    this[kHeaders] = headers;\x0d\n    this[kRawHeaders] = rawHeaders;\x0d\n    this[kTrailers] = {};\x0d\n    this[kRawTrailers] = [];\x0d\n    this[kStream] = stream;\x0d\n    this[kAborted] = false;\x0d\n    stream[kProxySocket] = null;\x0d\n    stream[kRequest] = this;\x0d\n\x0d\n    // Pause the stream..\x0d\n    stream.on('trailers'\x2C onStreamTrailers);\x0d\n    stream.on('end'\x2C onStreamEnd);\x0d\n    stream.on('error'\x2C onStreamError);\x0d\n    stream.on('aborted'\x2C onStreamAbortedRequest);\x0d\n    stream.on('close'\x2C onStreamCloseRequest);\x0d\n    stream.on('timeout'\x2C onStreamTimeout(kRequest));\x0d\n    this.on('pause'\x2C onRequestPause);\x0d\n    this.on('resume'\x2C onRequestResume);\x0d\n  }\x0d\n\x0d\n  get aborted() {\x0d\n    return this[kAborted];\x0d\n  }\x0d\n\x0d\n  get complete() {\x0d\n    return this[kAborted] ||\x0d\n           this.readableEnded ||\x0d\n           this[kState].closed ||\x0d\n           this[kStream].destroyed;\x0d\n  }\x0d\n\x0d\n  get stream() {\x0d\n    return this[kStream];\x0d\n  }\x0d\n\x0d\n  get headers() {\x0d\n    return this[kHeaders];\x0d\n  }\x0d\n\x0d\n  get rawHeaders() {\x0d\n    return this[kRawHeaders];\x0d\n  }\x0d\n\x0d\n  get trailers() {\x0d\n    return this[kTrailers];\x0d\n  }\x0d\n\x0d\n  get rawTrailers() {\x0d\n    return this[kRawTrailers];\x0d\n  }\x0d\n\x0d\n  get httpVersionMajor() {\x0d\n    return 2;\x0d\n  }\x0d\n\x0d\n  get httpVersionMinor() {\x0d\n    return 0;\x0d\n  }\x0d\n\x0d\n  get httpVersion() {\x0d\n    return '2.0';\x0d\n  }\x0d\n\x0d\n  get socket() {\x0d\n    const stream = this[kStream];\x0d\n    const proxySocket = stream[kProxySocket];\x0d\n    if (proxySocket === null)\x0d\n      return stream[kProxySocket] = new Proxy(stream\x2C proxySocketHandler);\x0d\n    return proxySocket;\x0d\n  }\x0d\n\x0d\n  get connection() {\x0d\n    return this.socket;\x0d\n  }\x0d\n\x0d\n  _read(nread) {\x0d\n    const state = this[kState];\x0d\n    assert(!state.closed);\x0d\n    if (!state.didRead) {\x0d\n      state.didRead = true;\x0d\n      this[kStream].on('data'\x2C onStreamData);\x0d\n    } else {\x0d\n      process.nextTick(resumeStream\x2C this[kStream]);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  get method() {\x0d\n    return this[kHeaders][HTTP2_HEADER_METHOD];\x0d\n  }\x0d\n\x0d\n  set method(method) {\x0d\n    validateString(method\x2C 'method');\x0d\n    if (method.trim() === '')\x0d\n      throw new ERR_INVALID_ARG_VALUE('method'\x2C method);\x0d\n\x0d\n    this[kHeaders][HTTP2_HEADER_METHOD] = method;\x0d\n  }\x0d\n\x0d\n  get authority() {\x0d\n    return getAuthority(this[kHeaders]);\x0d\n  }\x0d\n\x0d\n  get scheme() {\x0d\n    return this[kHeaders][HTTP2_HEADER_SCHEME];\x0d\n  }\x0d\n\x0d\n  get url() {\x0d\n    return this[kHeaders][HTTP2_HEADER_PATH];\x0d\n  }\x0d\n\x0d\n  set url(url) {\x0d\n    this[kHeaders][HTTP2_HEADER_PATH] = url;\x0d\n  }\x0d\n\x0d\n  setTimeout(msecs\x2C callback) {\x0d\n    if (!this[kState].closed)\x0d\n      this[kStream].setTimeout(msecs\x2C callback);\x0d\n    return this;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStreamTrailersReady() {\x0d\n  this.sendTrailers(this[kResponse][kTrailers]);\x0d\n}\x0d\n\x0d\nfunction onStreamCloseResponse() {\x0d\n  const res = this[kResponse];\x0d\n\x0d\n  if (res === undefined)\x0d\n    return;\x0d\n\x0d\n  const state = res[kState];\x0d\n\x0d\n  if (this.headRequest !== state.headRequest)\x0d\n    return;\x0d\n\x0d\n  state.closed = true;\x0d\n\x0d\n  this[kProxySocket] = null;\x0d\n\x0d\n  this.removeListener('wantTrailers'\x2C onStreamTrailersReady);\x0d\n  this[kResponse] = undefined;\x0d\n\x0d\n  res.emit('finish');\x0d\n  res.emit('close');\x0d\n}\x0d\n\x0d\nclass Http2ServerResponse extends Stream {\x0d\n  constructor(stream\x2C options) {\x0d\n    super(options);\x0d\n    this[kState] = {\x0d\n      closed: false\x2C\x0d\n      ending: false\x2C\x0d\n      destroyed: false\x2C\x0d\n      headRequest: false\x2C\x0d\n      sendDate: true\x2C\x0d\n      statusCode: HTTP_STATUS_OK\x2C\x0d\n    };\x0d\n    this[kHeaders] = { __proto__: null };\x0d\n    this[kTrailers] = { __proto__: null };\x0d\n    this[kStream] = stream;\x0d\n    stream[kProxySocket] = null;\x0d\n    stream[kResponse] = this;\x0d\n    this.writable = true;\x0d\n    this.req = stream[kRequest];\x0d\n    stream.on('drain'\x2C onStreamDrain);\x0d\n    stream.on('aborted'\x2C onStreamAbortedResponse);\x0d\n    stream.on('close'\x2C onStreamCloseResponse);\x0d\n    stream.on('wantTrailers'\x2C onStreamTrailersReady);\x0d\n    stream.on('timeout'\x2C onStreamTimeout(kResponse));\x0d\n  }\x0d\n\x0d\n  // User land modules such as finalhandler just check truthiness of this\x0d\n  // but if someone is actually trying to use this for more than that\x0d\n  // then we simply can't support such use cases\x0d\n  get _header() {\x0d\n    return this.headersSent;\x0d\n  }\x0d\n\x0d\n  get writableEnded() {\x0d\n    const state = this[kState];\x0d\n    return state.ending;\x0d\n  }\x0d\n\x0d\n  get finished() {\x0d\n    const state = this[kState];\x0d\n    return state.ending;\x0d\n  }\x0d\n\x0d\n  get socket() {\x0d\n    // This is compatible with http1 which removes socket reference\x0d\n    // only from ServerResponse but not IncomingMessage\x0d\n    if (this[kState].closed)\x0d\n      return undefined;\x0d\n\x0d\n    const stream = this[kStream];\x0d\n    const proxySocket = stream[kProxySocket];\x0d\n    if (proxySocket === null)\x0d\n      return stream[kProxySocket] = new Proxy(stream\x2C proxySocketHandler);\x0d\n    return proxySocket;\x0d\n  }\x0d\n\x0d\n  get connection() {\x0d\n    return this.socket;\x0d\n  }\x0d\n\x0d\n  get stream() {\x0d\n    return this[kStream];\x0d\n  }\x0d\n\x0d\n  get headersSent() {\x0d\n    return this[kStream].headersSent;\x0d\n  }\x0d\n\x0d\n  get sendDate() {\x0d\n    return this[kState].sendDate;\x0d\n  }\x0d\n\x0d\n  set sendDate(bool) {\x0d\n    this[kState].sendDate = Boolean(bool);\x0d\n  }\x0d\n\x0d\n  get statusCode() {\x0d\n    return this[kState].statusCode;\x0d\n  }\x0d\n\x0d\n  get writableCorked() {\x0d\n    return this[kStream].writableCorked;\x0d\n  }\x0d\n\x0d\n  get writableHighWaterMark() {\x0d\n    return this[kStream].writableHighWaterMark;\x0d\n  }\x0d\n\x0d\n  get writableFinished() {\x0d\n    return this[kStream].writableFinished;\x0d\n  }\x0d\n\x0d\n  get writableLength() {\x0d\n    return this[kStream].writableLength;\x0d\n  }\x0d\n\x0d\n  set statusCode(code) {\x0d\n    code |= 0;\x0d\n    if (code >= 100 && code < 200)\x0d\n      throw new ERR_HTTP2_INFO_STATUS_NOT_ALLOWED();\x0d\n    if (code < 100 || code > 599)\x0d\n      throw new ERR_HTTP2_STATUS_INVALID(code);\x0d\n    this[kState].statusCode = code;\x0d\n  }\x0d\n\x0d\n  setTrailer(name\x2C value) {\x0d\n    validateString(name\x2C 'name');\x0d\n    name = name.trim().toLowerCase();\x0d\n    assertValidHeader(name\x2C value);\x0d\n    this[kTrailers][name] = value;\x0d\n  }\x0d\n\x0d\n  addTrailers(headers) {\x0d\n    const keys = ObjectKeys(headers);\x0d\n    let key = '';\x0d\n    for (let i = 0; i < keys.length; i++) {\x0d\n      key = keys[i];\x0d\n      this.setTrailer(key\x2C headers[key]);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  getHeader(name) {\x0d\n    validateString(name\x2C 'name');\x0d\n    name = name.trim().toLowerCase();\x0d\n    return this[kHeaders][name];\x0d\n  }\x0d\n\x0d\n  getHeaderNames() {\x0d\n    return ObjectKeys(this[kHeaders]);\x0d\n  }\x0d\n\x0d\n  getHeaders() {\x0d\n    const headers = { __proto__: null };\x0d\n    return ObjectAssign(headers\x2C this[kHeaders]);\x0d\n  }\x0d\n\x0d\n  hasHeader(name) {\x0d\n    validateString(name\x2C 'name');\x0d\n    name = name.trim().toLowerCase();\x0d\n    return ObjectHasOwn(this[kHeaders]\x2C name);\x0d\n  }\x0d\n\x0d\n  removeHeader(name) {\x0d\n    validateString(name\x2C 'name');\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    name = name.trim().toLowerCase();\x0d\n\x0d\n    if (name === 'date') {\x0d\n      this[kState].sendDate = false;\x0d\n\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    delete this[kHeaders][name];\x0d\n  }\x0d\n\x0d\n  setHeader(name\x2C value) {\x0d\n    validateString(name\x2C 'name');\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    this[kSetHeader](name\x2C value);\x0d\n  }\x0d\n\x0d\n  [kSetHeader](name\x2C value) {\x0d\n    name = name.trim().toLowerCase();\x0d\n    assertValidHeader(name\x2C value);\x0d\n\x0d\n    if (!isConnectionHeaderAllowed(name\x2C value)) {\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    if (name[0] === ':')\x0d\n      assertValidPseudoHeader(name);\x0d\n    else if (!checkIsHttpToken(name))\x0d\n      this.destroy(new ERR_INVALID_HTTP_TOKEN('Header name'\x2C name));\x0d\n\x0d\n    this[kHeaders][name] = value;\x0d\n  }\x0d\n\x0d\n  appendHeader(name\x2C value) {\x0d\n    validateString(name\x2C 'name');\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    this[kAppendHeader](name\x2C value);\x0d\n  }\x0d\n\x0d\n  [kAppendHeader](name\x2C value) {\x0d\n    name = name.trim().toLowerCase();\x0d\n    assertValidHeader(name\x2C value);\x0d\n\x0d\n    if (!isConnectionHeaderAllowed(name\x2C value)) {\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    if (name[0] === ':')\x0d\n      assertValidPseudoHeader(name);\x0d\n    else if (!checkIsHttpToken(name))\x0d\n      this.destroy(new ERR_INVALID_HTTP_TOKEN('Header name'\x2C name));\x0d\n\x0d\n    // Handle various possible cases the same as OutgoingMessage.appendHeader:\x0d\n    const headers = this[kHeaders];\x0d\n    if (headers === null || !headers[name]) {\x0d\n      return this.setHeader(name\x2C value);\x0d\n    }\x0d\n\x0d\n    if (!ArrayIsArray(headers[name])) {\x0d\n      headers[name] = [headers[name]];\x0d\n    }\x0d\n\x0d\n    const existingValues = headers[name];\x0d\n    if (ArrayIsArray(value)) {\x0d\n      for (let i = 0\x2C length = value.length; i < length; i++) {\x0d\n        existingValues.push(value[i]);\x0d\n      }\x0d\n    } else {\x0d\n      existingValues.push(value);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  get statusMessage() {\x0d\n    statusMessageWarn();\x0d\n\x0d\n    return '';\x0d\n  }\x0d\n\x0d\n  set statusMessage(msg) {\x0d\n    statusMessageWarn();\x0d\n  }\x0d\n\x0d\n  flushHeaders() {\x0d\n    const state = this[kState];\x0d\n    if (!state.closed && !this[kStream].headersSent)\x0d\n      this.writeHead(state.statusCode);\x0d\n  }\x0d\n\x0d\n  writeHead(statusCode\x2C statusMessage\x2C headers) {\x0d\n    const state = this[kState];\x0d\n\x0d\n    if (state.closed || this.stream.destroyed || this.stream.closed)\x0d\n      return this;\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    if (typeof statusMessage === 'string')\x0d\n      statusMessageWarn();\x0d\n\x0d\n    if (headers === undefined && typeof statusMessage === 'object')\x0d\n      headers = statusMessage;\x0d\n\x0d\n    let i;\x0d\n    if (ArrayIsArray(headers)) {\x0d\n      if (this[kHeaders]) {\x0d\n        // Headers in obj should override previous headers but still\x0d\n        // allow explicit duplicates. To do so\x2C we first remove any\x0d\n        // existing conflicts\x2C then use appendHeader. This is the\x0d\n        // slow path\x2C which only applies when you use setHeader and\x0d\n        // then pass headers in writeHead too.\x0d\n\x0d\n        // We need to handle both the tuple and flat array formats\x2C just\x0d\n        // like the logic further below.\x0d\n        if (headers.length && ArrayIsArray(headers[0])) {\x0d\n          for (let n = 0; n < headers.length; n += 1) {\x0d\n            const key = headers[n + 0][0];\x0d\n            this.removeHeader(key);\x0d\n          }\x0d\n        } else {\x0d\n          for (let n = 0; n < headers.length; n += 2) {\x0d\n            const key = headers[n + 0];\x0d\n            this.removeHeader(key);\x0d\n          }\x0d\n        }\x0d\n      }\x0d\n\x0d\n      // Append all the headers provided in the array:\x0d\n      if (headers.length && ArrayIsArray(headers[0])) {\x0d\n        for (i = 0; i < headers.length; i++) {\x0d\n          const header = headers[i];\x0d\n          this[kAppendHeader](header[0]\x2C header[1]);\x0d\n        }\x0d\n      } else {\x0d\n        if (headers.length % 2 !== 0) {\x0d\n          throw new ERR_INVALID_ARG_VALUE('headers'\x2C headers);\x0d\n        }\x0d\n\x0d\n        for (i = 0; i < headers.length; i += 2) {\x0d\n          this[kAppendHeader](headers[i]\x2C headers[i + 1]);\x0d\n        }\x0d\n      }\x0d\n    } else if (typeof headers === 'object') {\x0d\n      const keys = ObjectKeys(headers);\x0d\n      let key = '';\x0d\n      for (i = 0; i < keys.length; i++) {\x0d\n        key = keys[i];\x0d\n        this[kSetHeader](key\x2C headers[key]);\x0d\n      }\x0d\n    }\x0d\n\x0d\n    state.statusCode = statusCode;\x0d\n    this[kBeginSend]();\x0d\n\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  cork() {\x0d\n    this[kStream].cork();\x0d\n  }\x0d\n\x0d\n  uncork() {\x0d\n    this[kStream].uncork();\x0d\n  }\x0d\n\x0d\n  write(chunk\x2C encoding\x2C cb) {\x0d\n    const state = this[kState];\x0d\n\x0d\n    if (typeof encoding === 'function') {\x0d\n      cb = encoding;\x0d\n      encoding = 'utf8';\x0d\n    }\x0d\n\x0d\n    let err;\x0d\n    if (state.ending) {\x0d\n      err = new ERR_STREAM_WRITE_AFTER_END();\x0d\n    } else if (state.closed) {\x0d\n      err = new ERR_HTTP2_INVALID_STREAM();\x0d\n    } else if (state.destroyed) {\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    if (err) {\x0d\n      if (typeof cb === 'function')\x0d\n        process.nextTick(cb\x2C err);\x0d\n      this.destroy(err);\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    const stream = this[kStream];\x0d\n    if (!stream.headersSent)\x0d\n      this.writeHead(state.statusCode);\x0d\n    return stream.write(chunk\x2C encoding\x2C cb);\x0d\n  }\x0d\n\x0d\n  end(chunk\x2C encoding\x2C cb) {\x0d\n    const stream = this[kStream];\x0d\n    const state = this[kState];\x0d\n\x0d\n    if (typeof chunk === 'function') {\x0d\n      cb = chunk;\x0d\n      chunk = null;\x0d\n    } else if (typeof encoding === 'function') {\x0d\n      cb = encoding;\x0d\n      encoding = 'utf8';\x0d\n    }\x0d\n\x0d\n    if ((state.closed || state.ending) &&\x0d\n        state.headRequest === stream.headRequest) {\x0d\n      if (typeof cb === 'function') {\x0d\n        process.nextTick(cb);\x0d\n      }\x0d\n      return this;\x0d\n    }\x0d\n\x0d\n    if (chunk !== null && chunk !== undefined)\x0d\n      this.write(chunk\x2C encoding);\x0d\n\x0d\n    state.headRequest = stream.headRequest;\x0d\n    state.ending = true;\x0d\n\x0d\n    if (typeof cb === 'function') {\x0d\n      if (stream.writableEnded)\x0d\n        this.once('finish'\x2C cb);\x0d\n      else\x0d\n        stream.once('finish'\x2C cb);\x0d\n    }\x0d\n\x0d\n    if (!stream.headersSent)\x0d\n      this.writeHead(this[kState].statusCode);\x0d\n\x0d\n    if (this[kState].closed || stream.destroyed)\x0d\n      ReflectApply(onStreamCloseResponse\x2C stream\x2C []);\x0d\n    else\x0d\n      stream.end();\x0d\n\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  destroy(err) {\x0d\n    if (this[kState].destroyed)\x0d\n      return;\x0d\n\x0d\n    this[kState].destroyed = true;\x0d\n    this[kStream].destroy(err);\x0d\n  }\x0d\n\x0d\n  setTimeout(msecs\x2C callback) {\x0d\n    if (this[kState].closed)\x0d\n      return;\x0d\n    this[kStream].setTimeout(msecs\x2C callback);\x0d\n  }\x0d\n\x0d\n  createPushResponse(headers\x2C callback) {\x0d\n    validateFunction(callback\x2C 'callback');\x0d\n    if (this[kState].closed) {\x0d\n      process.nextTick(callback\x2C new ERR_HTTP2_INVALID_STREAM());\x0d\n      return;\x0d\n    }\x0d\n    this[kStream].pushStream(headers\x2C {}\x2C (err\x2C stream\x2C headers\x2C options) => {\x0d\n      if (err) {\x0d\n        callback(err);\x0d\n        return;\x0d\n      }\x0d\n      callback(null\x2C new Http2ServerResponse(stream));\x0d\n    });\x0d\n  }\x0d\n\x0d\n  [kBeginSend]() {\x0d\n    const state = this[kState];\x0d\n    const headers = this[kHeaders];\x0d\n    headers[HTTP2_HEADER_STATUS] = state.statusCode;\x0d\n    const options = {\x0d\n      endStream: state.ending\x2C\x0d\n      waitForTrailers: true\x2C\x0d\n      sendDate: state.sendDate\x2C\x0d\n    };\x0d\n    this[kStream].respond(headers\x2C options);\x0d\n  }\x0d\n\x0d\n  // TODO doesn't support callbacks\x0d\n  writeContinue() {\x0d\n    const stream = this[kStream];\x0d\n    if (stream.headersSent || this[kState].closed)\x0d\n      return false;\x0d\n    stream.additionalHeaders({\x0d\n      [HTTP2_HEADER_STATUS]: HTTP_STATUS_CONTINUE\x2C\x0d\n    });\x0d\n    return true;\x0d\n  }\x0d\n\x0d\n  writeEarlyHints(hints) {\x0d\n    validateObject(hints\x2C 'hints');\x0d\n\x0d\n    const headers = { __proto__: null };\x0d\n\x0d\n    const linkHeaderValue = validateLinkHeaderValue(hints.link);\x0d\n\x0d\n    for (const key of ObjectKeys(hints)) {\x0d\n      if (key !== 'link') {\x0d\n        headers[key] = hints[key];\x0d\n      }\x0d\n    }\x0d\n\x0d\n    if (linkHeaderValue.length === 0) {\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    const stream = this[kStream];\x0d\n\x0d\n    if (stream.headersSent || this[kState].closed)\x0d\n      return false;\x0d\n\x0d\n    stream.additionalHeaders({\x0d\n      ...headers\x2C\x0d\n      [HTTP2_HEADER_STATUS]: HTTP_STATUS_EARLY_HINTS\x2C\x0d\n      'Link': linkHeaderValue\x2C\x0d\n    });\x0d\n\x0d\n    return true;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onServerStream(ServerRequest\x2C ServerResponse\x2C\x0d\n                        stream\x2C headers\x2C flags\x2C rawHeaders) {\x0d\n  const server = this;\x0d\n  const request = new ServerRequest(stream\x2C headers\x2C undefined\x2C rawHeaders);\x0d\n  const response = new ServerResponse(stream);\x0d\n\x0d\n  // Check for the CONNECT method\x0d\n  const method = headers[HTTP2_HEADER_METHOD];\x0d\n  if (method === 'CONNECT') {\x0d\n    if (!server.emit('connect'\x2C request\x2C response)) {\x0d\n      response.statusCode = HTTP_STATUS_METHOD_NOT_ALLOWED;\x0d\n      response.end();\x0d\n    }\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Check for Expectations\x0d\n  if (headers.expect !== undefined) {\x0d\n    if (headers.expect === '100-continue') {\x0d\n      if (server.listenerCount('checkContinue')) {\x0d\n        server.emit('checkContinue'\x2C request\x2C response);\x0d\n      } else {\x0d\n        response.writeContinue();\x0d\n        server.emit('request'\x2C request\x2C response);\x0d\n      }\x0d\n    } else if (server.listenerCount('checkExpectation')) {\x0d\n      server.emit('checkExpectation'\x2C request\x2C response);\x0d\n    } else {\x0d\n      response.statusCode = HTTP_STATUS_EXPECTATION_FAILED;\x0d\n      response.end();\x0d\n    }\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  server.emit('request'\x2C request\x2C response);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  onServerStream\x2C\x0d\n  Http2ServerRequest\x2C\x0d\n  Http2ServerResponse\x2C\x0d\n};\x0d\n
