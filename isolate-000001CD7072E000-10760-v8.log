script-source,51,node:internal/process/permission,'use strict';\x0d\n\x0d\nconst {\x0d\n  ObjectFreeze\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst permission = internalBinding('permission');\x0d\nconst { validateString\x2C validateBuffer } = require('internal/validators');\x0d\nconst { Buffer } = require('buffer');\x0d\nconst { isBuffer } = Buffer;\x0d\n\x0d\nlet _permission;\x0d\n\x0d\nmodule.exports = ObjectFreeze({\x0d\n  __proto__: null\x2C\x0d\n  isEnabled() {\x0d\n    if (_permission === undefined) {\x0d\n      const { getOptionValue } = require('internal/options');\x0d\n      _permission = getOptionValue('--permission');\x0d\n    }\x0d\n    return _permission;\x0d\n  }\x2C\x0d\n  has(scope\x2C reference) {\x0d\n    validateString(scope\x2C 'scope');\x0d\n    if (reference != null) {\x0d\n      // TODO: add support for WHATWG URLs and Uint8Arrays.\x0d\n      if (isBuffer(reference)) {\x0d\n        validateBuffer(reference\x2C 'reference');\x0d\n      } else {\x0d\n        validateString(reference\x2C 'reference');\x0d\n      }\x0d\n    }\x0d\n\x0d\n    return permission.has(scope\x2C reference);\x0d\n  }\x2C\x0d\n  availableFlags() {\x0d\n    return [\x0d\n      '--allow-fs-read'\x2C\x0d\n      '--allow-fs-write'\x2C\x0d\n      '--allow-addons'\x2C\x0d\n      '--allow-child-process'\x2C\x0d\n      '--allow-wasi'\x2C\x0d\n      '--allow-worker'\x2C\x0d\n    ];\x0d\n  }\x2C\x0d\n});\x0d\n
