script-source,269,node:internal/assert/assertion_error,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeJoin\x2C\x0d\n  ArrayPrototypePop\x2C\x0d\n  ArrayPrototypeSlice\x2C\x0d\n  Error\x2C\x0d\n  ErrorCaptureStackTrace\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectGetPrototypeOf\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  String\x2C\x0d\n  StringPrototypeRepeat\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeSplit\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst { isError } = require('internal/util');\x0d\n\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\nconst colors = require('internal/util/colors');\x0d\nconst { validateObject } = require('internal/validators');\x0d\nconst { isErrorStackTraceLimitWritable } = require('internal/errors');\x0d\nconst { myersDiff\x2C printMyersDiff\x2C printSimpleMyersDiff } = require('internal/assert/myers_diff');\x0d\n\x0d\nconst kReadableOperator = {\x0d\n  deepStrictEqual: 'Expected values to be strictly deep-equal:'\x2C\x0d\n  partialDeepStrictEqual: 'Expected values to be partially and strictly deep-equal:'\x2C\x0d\n  strictEqual: 'Expected values to be strictly equal:'\x2C\x0d\n  strictEqualObject: 'Expected "actual" to be reference-equal to "expected":'\x2C\x0d\n  deepEqual: 'Expected values to be loosely deep-equal:'\x2C\x0d\n  notDeepStrictEqual: 'Expected "actual" not to be strictly deep-equal to:'\x2C\x0d\n  notStrictEqual: 'Expected "actual" to be strictly unequal to:'\x2C\x0d\n  notStrictEqualObject:\x0d\n    'Expected "actual" not to be reference-equal to "expected":'\x2C\x0d\n  notDeepEqual: 'Expected "actual" not to be loosely deep-equal to:'\x2C\x0d\n  notIdentical: 'Values have same structure but are not reference-equal:'\x2C\x0d\n  notDeepEqualUnequal: 'Expected values not to be loosely deep-equal:'\x2C\x0d\n};\x0d\n\x0d\nconst kMaxShortStringLength = 12;\x0d\nconst kMaxLongStringLength = 512;\x0d\n\x0d\nconst kMethodsWithCustomMessageDiff = ['deepStrictEqual'\x2C 'strictEqual'\x2C 'partialDeepStrictEqual'];\x0d\n\x0d\nfunction copyError(source) {\x0d\n  const target = ObjectAssign(\x0d\n    { __proto__: ObjectGetPrototypeOf(source) }\x2C\x0d\n    source\x2C\x0d\n  );\x0d\n  ObjectDefineProperty(target\x2C 'message'\x2C {\x0d\n    __proto__: null\x2C\x0d\n    value: source.message\x2C\x0d\n  });\x0d\n  if (ObjectPrototypeHasOwnProperty(source\x2C 'cause')) {\x0d\n    let { cause } = source;\x0d\n\x0d\n    if (isError(cause)) {\x0d\n      cause = copyError(cause);\x0d\n    }\x0d\n\x0d\n    ObjectDefineProperty(target\x2C 'cause'\x2C { __proto__: null\x2C value: cause });\x0d\n  }\x0d\n  return target;\x0d\n}\x0d\n\x0d\nfunction inspectValue(val) {\x0d\n  // The util.inspect default values could be changed. This makes sure the\x0d\n  // error messages contain the necessary information nevertheless.\x0d\n  return inspect(val\x2C {\x0d\n    compact: false\x2C\x0d\n    customInspect: false\x2C\x0d\n    depth: 1000\x2C\x0d\n    maxArrayLength: Infinity\x2C\x0d\n    // Assert compares only enumerable properties (with a few exceptions).\x0d\n    showHidden: false\x2C\x0d\n    // Assert does not detect proxies currently.\x0d\n    showProxy: false\x2C\x0d\n    sorted: true\x2C\x0d\n    // Inspect getters as we also check them when comparing entries.\x0d\n    getters: true\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction getErrorMessage(operator\x2C message) {\x0d\n  return message || kReadableOperator[operator];\x0d\n}\x0d\n\x0d\nfunction checkOperator(actual\x2C expected\x2C operator) {\x0d\n  // In case both values are objects or functions explicitly mark them as not\x0d\n  // reference equal for the `strictEqual` operator.\x0d\n  if (\x0d\n    operator === 'strictEqual' &&\x0d\n    ((typeof actual === 'object' &&\x0d\n      actual !== null &&\x0d\n      typeof expected === 'object' &&\x0d\n      expected !== null) ||\x0d\n      (typeof actual === 'function' && typeof expected === 'function'))\x0d\n  ) {\x0d\n    operator = 'strictEqualObject';\x0d\n  }\x0d\n\x0d\n  return operator;\x0d\n}\x0d\n\x0d\nfunction getColoredMyersDiff(actual\x2C expected) {\x0d\n  const header = `${colors.green}actual${colors.white} ${colors.red}expected${colors.white}`;\x0d\n  const skipped = false;\x0d\n\x0d\n  const diff = myersDiff(StringPrototypeSplit(actual\x2C '')\x2C StringPrototypeSplit(expected\x2C ''));\x0d\n  let message = printSimpleMyersDiff(diff);\x0d\n\x0d\n  if (skipped) {\x0d\n    message += '...';\x0d\n  }\x0d\n\x0d\n  return { message\x2C header\x2C skipped };\x0d\n}\x0d\n\x0d\nfunction getStackedDiff(actual\x2C expected) {\x0d\n  const isStringComparison = typeof actual === 'string' && typeof expected === 'string';\x0d\n\x0d\n  let message = `\\n${colors.green}+${colors.white} ${actual}\\n${colors.red}- ${colors.white}${expected}`;\x0d\n  const stringsLen = actual.length + expected.length;\x0d\n  const maxTerminalLength = process.stderr.isTTY ? process.stderr.columns : 80;\x0d\n  const showIndicator = isStringComparison && (stringsLen <= maxTerminalLength);\x0d\n\x0d\n  if (showIndicator) {\x0d\n    let indicatorIdx = -1;\x0d\n\x0d\n    for (let i = 0; i < actual.length; i++) {\x0d\n      if (actual[i] !== expected[i]) {\x0d\n        // Skip the indicator for the first 2 characters because the diff is immediately apparent\x0d\n        // It is 3 instead of 2 to account for the quotes\x0d\n        if (i >= 3) {\x0d\n          indicatorIdx = i;\x0d\n        }\x0d\n        break;\x0d\n      }\x0d\n    }\x0d\n\x0d\n    if (indicatorIdx !== -1) {\x0d\n      message += `\\n${StringPrototypeRepeat(' '\x2C indicatorIdx + 2)}^`;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return { message };\x0d\n}\x0d\n\x0d\nfunction getSimpleDiff(originalActual\x2C actual\x2C originalExpected\x2C expected) {\x0d\n  let stringsLen = actual.length + expected.length;\x0d\n  // Accounting for the quotes wrapping strings\x0d\n  if (typeof originalActual === 'string') {\x0d\n    stringsLen -= 2;\x0d\n  }\x0d\n  if (typeof originalExpected === 'string') {\x0d\n    stringsLen -= 2;\x0d\n  }\x0d\n  if (stringsLen <= kMaxShortStringLength && (originalActual !== 0 || originalExpected !== 0)) {\x0d\n    return { message: `${actual} !== ${expected}`\x2C header: '' };\x0d\n  }\x0d\n\x0d\n  const isStringComparison = typeof originalActual === 'string' && typeof originalExpected === 'string';\x0d\n  // colored myers diff\x0d\n  if (isStringComparison && colors.hasColors) {\x0d\n    return getColoredMyersDiff(actual\x2C expected);\x0d\n  }\x0d\n\x0d\n  return getStackedDiff(actual\x2C expected);\x0d\n}\x0d\n\x0d\nfunction isSimpleDiff(actual\x2C inspectedActual\x2C expected\x2C inspectedExpected) {\x0d\n  if (inspectedActual.length > 1 || inspectedExpected.length > 1) {\x0d\n    return false;\x0d\n  }\x0d\n\x0d\n  return typeof actual !== 'object' || actual === null || typeof expected !== 'object' || expected === null;\x0d\n}\x0d\n\x0d\nfunction createErrDiff(actual\x2C expected\x2C operator\x2C customMessage\x2C diffType = 'simple') {\x0d\n  operator = checkOperator(actual\x2C expected\x2C operator);\x0d\n\x0d\n  let skipped = false;\x0d\n  let message = '';\x0d\n  const inspectedActual = inspectValue(actual);\x0d\n  const inspectedExpected = inspectValue(expected);\x0d\n  const inspectedSplitActual = StringPrototypeSplit(inspectedActual\x2C '\\n');\x0d\n  const inspectedSplitExpected = StringPrototypeSplit(inspectedExpected\x2C '\\n');\x0d\n  const showSimpleDiff = isSimpleDiff(actual\x2C inspectedSplitActual\x2C expected\x2C inspectedSplitExpected);\x0d\n  let header = `${colors.green}+ actual${colors.white} ${colors.red}- expected${colors.white}`;\x0d\n\x0d\n  if (showSimpleDiff) {\x0d\n    const simpleDiff = getSimpleDiff(actual\x2C inspectedSplitActual[0]\x2C expected\x2C inspectedSplitExpected[0]);\x0d\n    message = simpleDiff.message;\x0d\n    if (typeof simpleDiff.header !== 'undefined') {\x0d\n      header = simpleDiff.header;\x0d\n    }\x0d\n    if (simpleDiff.skipped) {\x0d\n      skipped = true;\x0d\n    }\x0d\n  } else if (inspectedActual === inspectedExpected) {\x0d\n    // Handles the case where the objects are structurally the same but different references\x0d\n    operator = 'notIdentical';\x0d\n    if (inspectedSplitActual.length > 50 && diffType !== 'full') {\x0d\n      message = `${ArrayPrototypeJoin(ArrayPrototypeSlice(inspectedSplitActual\x2C 0\x2C 50)\x2C '\\n')}\\n...}`;\x0d\n      skipped = true;\x0d\n    } else {\x0d\n      message = ArrayPrototypeJoin(inspectedSplitActual\x2C '\\n');\x0d\n    }\x0d\n    header = '';\x0d\n  } else {\x0d\n    const checkCommaDisparity = actual != null && typeof actual === 'object';\x0d\n    const diff = myersDiff(inspectedSplitActual\x2C inspectedSplitExpected\x2C checkCommaDisparity);\x0d\n\x0d\n    const myersDiffMessage = printMyersDiff(diff\x2C operator);\x0d\n    message = myersDiffMessage.message;\x0d\n\x0d\n    if (operator === 'partialDeepStrictEqual') {\x0d\n      header = `${colors.gray}${colors.hasColors ? '' : '+ '}actual${colors.white} ${colors.red}- expected${colors.white}`;\x0d\n    }\x0d\n\x0d\n    if (myersDiffMessage.skipped) {\x0d\n      skipped = true;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const headerMessage = `${getErrorMessage(operator\x2C customMessage)}\\n${header}`;\x0d\n  const skippedMessage = skipped ? '\\n... Skipped lines' : '';\x0d\n\x0d\n  return `${headerMessage}${skippedMessage}\\n${message}\\n`;\x0d\n}\x0d\n\x0d\nfunction addEllipsis(string) {\x0d\n  const lines = StringPrototypeSplit(string\x2C '\\n'\x2C 11);\x0d\n  if (lines.length > 10) {\x0d\n    lines.length = 10;\x0d\n    return `${ArrayPrototypeJoin(lines\x2C '\\n')}\\n...`;\x0d\n  } else if (string.length > kMaxLongStringLength) {\x0d\n    return `${StringPrototypeSlice(string\x2C kMaxLongStringLength)}...`;\x0d\n  }\x0d\n  return string;\x0d\n}\x0d\n\x0d\nclass AssertionError extends Error {\x0d\n  constructor(options) {\x0d\n    validateObject(options\x2C 'options');\x0d\n    const {\x0d\n      message\x2C\x0d\n      operator\x2C\x0d\n      stackStartFn\x2C\x0d\n      details\x2C\x0d\n      // Compatibility with older versions.\x0d\n      stackStartFunction\x2C\x0d\n      diff = 'simple'\x2C\x0d\n    } = options;\x0d\n    let {\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n    } = options;\x0d\n\x0d\n    const limit = Error.stackTraceLimit;\x0d\n    if (isErrorStackTraceLimitWritable()) Error.stackTraceLimit = 0;\x0d\n\x0d\n    if (message != null) {\x0d\n      if (kMethodsWithCustomMessageDiff.includes(operator)) {\x0d\n        super(createErrDiff(actual\x2C expected\x2C operator\x2C message\x2C diff));\x0d\n      } else {\x0d\n        super(String(message));\x0d\n      }\x0d\n    } else {\x0d\n      // Reset colors on each call to make sure we handle dynamically set environment\x0d\n      // variables correct.\x0d\n      colors.refresh();\x0d\n      // Prevent the error stack from being visible by duplicating the error\x0d\n      // in a very close way to the original in case both sides are actually\x0d\n      // instances of Error.\x0d\n      if (typeof actual === 'object' && actual !== null &&\x0d\n          typeof expected === 'object' && expected !== null &&\x0d\n          'stack' in actual && actual instanceof Error &&\x0d\n          'stack' in expected && expected instanceof Error) {\x0d\n        actual = copyError(actual);\x0d\n        expected = copyError(expected);\x0d\n      }\x0d\n\x0d\n      if (kMethodsWithCustomMessageDiff.includes(operator)) {\x0d\n        super(createErrDiff(actual\x2C expected\x2C operator\x2C message\x2C diff));\x0d\n      } else if (operator === 'notDeepStrictEqual' ||\x0d\n        operator === 'notStrictEqual') {\x0d\n        // In case the objects are equal but the operator requires unequal\x2C show\x0d\n        // the first object and say A equals B\x0d\n        let base = kReadableOperator[operator];\x0d\n        const res = StringPrototypeSplit(inspectValue(actual)\x2C '\\n');\x0d\n\x0d\n        // In case "actual" is an object or a function\x2C it should not be\x0d\n        // reference equal.\x0d\n        if (operator === 'notStrictEqual' &&\x0d\n            ((typeof actual === 'object' && actual !== null) ||\x0d\n             typeof actual === 'function')) {\x0d\n          base = kReadableOperator.notStrictEqualObject;\x0d\n        }\x0d\n\x0d\n        // Only remove lines in case it makes sense to collapse those.\x0d\n        if (res.length > 50 && diff !== 'full') {\x0d\n          res[46] = `${colors.blue}...${colors.white}`;\x0d\n          while (res.length > 47) {\x0d\n            ArrayPrototypePop(res);\x0d\n          }\x0d\n        }\x0d\n\x0d\n        // Only print a single input.\x0d\n        if (res.length === 1) {\x0d\n          super(`${base}${res[0].length > 5 ? '\\n\\n' : ' '}${res[0]}`);\x0d\n        } else {\x0d\n          super(`${base}\\n\\n${ArrayPrototypeJoin(res\x2C '\\n')}\\n`);\x0d\n        }\x0d\n      } else {\x0d\n        let res = inspectValue(actual);\x0d\n        let other = inspectValue(expected);\x0d\n        const knownOperator = kReadableOperator[operator];\x0d\n        if (operator === 'notDeepEqual' && res === other) {\x0d\n          res = `${knownOperator}\\n\\n${res}`;\x0d\n          if (res.length > 1024 && diff !== 'full') {\x0d\n            res = `${StringPrototypeSlice(res\x2C 0\x2C 1021)}...`;\x0d\n          }\x0d\n          super(res);\x0d\n        } else {\x0d\n          if (res.length > kMaxLongStringLength && diff !== 'full') {\x0d\n            res = `${StringPrototypeSlice(res\x2C 0\x2C 509)}...`;\x0d\n          }\x0d\n          if (other.length > kMaxLongStringLength && diff !== 'full') {\x0d\n            other = `${StringPrototypeSlice(other\x2C 0\x2C 509)}...`;\x0d\n          }\x0d\n          if (operator === 'deepEqual') {\x0d\n            res = `${knownOperator}\\n\\n${res}\\n\\nshould loosely deep-equal\\n\\n`;\x0d\n          } else {\x0d\n            const newOp = kReadableOperator[`${operator}Unequal`];\x0d\n            if (newOp) {\x0d\n              res = `${newOp}\\n\\n${res}\\n\\nshould not loosely deep-equal\\n\\n`;\x0d\n            } else {\x0d\n              other = ` ${operator} ${other}`;\x0d\n            }\x0d\n          }\x0d\n          super(`${res}${other}`);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n\x0d\n    if (isErrorStackTraceLimitWritable()) Error.stackTraceLimit = limit;\x0d\n\x0d\n    this.generatedMessage = !message;\x0d\n    ObjectDefineProperty(this\x2C 'name'\x2C {\x0d\n      __proto__: null\x2C\x0d\n      value: 'AssertionError [ERR_ASSERTION]'\x2C\x0d\n      enumerable: false\x2C\x0d\n      writable: true\x2C\x0d\n      configurable: true\x2C\x0d\n    });\x0d\n    this.code = 'ERR_ASSERTION';\x0d\n    if (details) {\x0d\n      this.actual = undefined;\x0d\n      this.expected = undefined;\x0d\n      this.operator = undefined;\x0d\n      for (let i = 0; i < details.length; i++) {\x0d\n        this['message ' + i] = details[i].message;\x0d\n        this['actual ' + i] = details[i].actual;\x0d\n        this['expected ' + i] = details[i].expected;\x0d\n        this['operator ' + i] = details[i].operator;\x0d\n        this['stack trace ' + i] = details[i].stack;\x0d\n      }\x0d\n    } else {\x0d\n      this.actual = actual;\x0d\n      this.expected = expected;\x0d\n      this.operator = operator;\x0d\n    }\x0d\n    ErrorCaptureStackTrace(this\x2C stackStartFn || stackStartFunction);\x0d\n    // Create error message including the error code in the name.\x0d\n    this.stack; // eslint-disable-line no-unused-expressions\x0d\n    // Reset the name.\x0d\n    this.name = 'AssertionError';\x0d\n    this.diff = diff;\x0d\n  }\x0d\n\x0d\n  toString() {\x0d\n    return `${this.name} [${this.code}]: ${this.message}`;\x0d\n  }\x0d\n\x0d\n  [inspect.custom](recurseTimes\x2C ctx) {\x0d\n    // Long strings should not be fully inspected.\x0d\n    const tmpActual = this.actual;\x0d\n    const tmpExpected = this.expected;\x0d\n\x0d\n    if (typeof this.actual === 'string') {\x0d\n      this.actual = addEllipsis(this.actual);\x0d\n    }\x0d\n    if (typeof this.expected === 'string') {\x0d\n      this.expected = addEllipsis(this.expected);\x0d\n    }\x0d\n\x0d\n    // This limits the `actual` and `expected` property default inspection to\x0d\n    // the minimum depth. Otherwise those values would be too verbose compared\x0d\n    // to the actual error message which contains a combined view of these two\x0d\n    // input values.\x0d\n    const result = inspect(this\x2C {\x0d\n      ...ctx\x2C\x0d\n      customInspect: false\x2C\x0d\n      depth: 0\x2C\x0d\n    });\x0d\n\x0d\n    // Reset the properties after inspection.\x0d\n    this.actual = tmpActual;\x0d\n    this.expected = tmpExpected;\x0d\n\x0d\n    return result;\x0d\n  }\x0d\n}\x0d\n\x0d\nmodule.exports = AssertionError;\x0d\n
