\x0d\n    ERR_HTTP2_ALTSVC_INVALID_ORIGIN\x2C\x0d\n    ERR_HTTP2_ALTSVC_LENGTH\x2C\x0d\n    ERR_HTTP2_GOAWAY_SESSION\x2C\x0d\n    ERR_HTTP2_HEADERS_AFTER_RESPOND\x2C\x0d\n    ERR_HTTP2_HEADERS_SENT\x2C\x0d\n    ERR_HTTP2_INVALID_INFO_STATUS\x2C\x0d\n    ERR_HTTP2_INVALID_ORIGIN\x2C\x0d\n    ERR_HTTP2_INVALID_PACKED_SETTINGS_LENGTH\x2C\x0d\n    ERR_HTTP2_INVALID_SESSION\x2C\x0d\n    ERR_HTTP2_INVALID_SETTING_VALUE\x2C\x0d\n    ERR_HTTP2_INVALID_STREAM\x2C\x0d\n    ERR_HTTP2_MAX_PENDING_SETTINGS_ACK\x2C\x0d\n    ERR_HTTP2_NESTED_PUSH\x2C\x0d\n    ERR_HTTP2_NO_MEM\x2C\x0d\n    ERR_HTTP2_NO_SOCKET_MANIPULATION\x2C\x0d\n    ERR_HTTP2_ORIGIN_LENGTH\x2C\x0d\n    ERR_HTTP2_OUT_OF_STREAMS\x2C\x0d\n    ERR_HTTP2_PAYLOAD_FORBIDDEN\x2C\x0d\n    ERR_HTTP2_PING_CANCEL\x2C\x0d\n    ERR_HTTP2_PING_LENGTH\x2C\x0d\n    ERR_HTTP2_PUSH_DISABLED\x2C\x0d\n    ERR_HTTP2_SEND_FILE\x2C\x0d\n    ERR_HTTP2_SEND_FILE_NOSEEK\x2C\x0d\n    ERR_HTTP2_SESSION_ERROR\x2C\x0d\n    ERR_HTTP2_SETTINGS_CANCEL\x2C\x0d\n    ERR_HTTP2_SOCKET_BOUND\x2C\x0d\n    ERR_HTTP2_SOCKET_UNBOUND\x2C\x0d\n    ERR_HTTP2_STATUS_101\x2C\x0d\n    ERR_HTTP2_STATUS_INVALID\x2C\x0d\n    ERR_HTTP2_STREAM_CANCEL\x2C\x0d\n    ERR_HTTP2_STREAM_ERROR\x2C\x0d\n    ERR_HTTP2_STREAM_SELF_DEPENDENCY\x2C\x0d\n    ERR_HTTP2_TOO_MANY_CUSTOM_SETTINGS\x2C\x0d\n    ERR_HTTP2_TRAILERS_ALREADY_SENT\x2C\x0d\n    ERR_HTTP2_TRAILERS_NOT_READY\x2C\x0d\n    ERR_HTTP2_UNSUPPORTED_PROTOCOL\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_CHAR\x2C\x0d\n    ERR_OUT_OF_RANGE\x2C\x0d\n    ERR_SOCKET_CLOSED\x2C\x0d\n  }\x2C\x0d\n  hideStackFrames\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  isUint32\x2C\x0d\n  validateAbortSignal\x2C\x0d\n  validateBoolean\x2C\x0d\n  validateBuffer\x2C\x0d\n  validateFunction\x2C\x0d\n  validateInt32\x2C\x0d\n  validateInteger\x2C\x0d\n  validateNumber\x2C\x0d\n  validateString\x2C\x0d\n  validateUint32\x2C\x0d\n} = require('internal/validators');\x0d\nconst fsPromisesInternal = require('internal/fs/promises');\x0d\nconst { utcDate } = require('internal/http');\x0d\nconst {\x0d\n  Http2ServerRequest\x2C\x0d\n  Http2ServerResponse\x2C\x0d\n  onServerStream\x2C\x0d\n} = require('internal/http2/compat');\x0d\n\x0d\nconst {\x0d\n  assertIsObject\x2C\x0d\n  assertIsArray\x2C\x0d\n  assertValidPseudoHeaderResponse\x2C\x0d\n  assertValidPseudoHeaderTrailer\x2C\x0d\n  assertWithinRange\x2C\x0d\n  buildNgHeaderString\x2C\x0d\n  getAuthority\x2C\x0d\n  getDefaultSettings\x2C\x0d\n  getSessionState\x2C\x0d\n  getSettings\x2C\x0d\n  getStreamState\x2C\x0d\n  isPayloadMeaningless\x2C\x0d\n  kAuthority\x2C\x0d\n  kSensitiveHeaders\x2C\x0d\n  kSocket\x2C\x0d\n  kRequest\x2C\x0d\n  kProtocol\x2C\x0d\n  kProxySocket\x2C\x0d\n  MAX_ADDITIONAL_SETTINGS\x2C\x0d\n  NghttpError\x2C\x0d\n  prepareRequestHeadersArray\x2C\x0d\n  prepareRequestHeadersObject\x2C\x0d\n  remoteCustomSettingsToBuffer\x2C\x0d\n  sessionName\x2C\x0d\n  toHeaderObject\x2C\x0d\n  updateOptionsBuffer\x2C\x0d\n  updateSettingsBuffer\x2C\x0d\n} = require('internal/http2/util');\x0d\nconst {\x0d\n  writeGeneric\x2C\x0d\n  writevGeneric\x2C\x0d\n  onStreamRead\x2C\x0d\n  kAfterAsyncWrite\x2C\x0d\n  kMaybeDestroy\x2C\x0d\n  kUpdateTimer\x2C\x0d\n  kHandle\x2C\x0d\n  kSession\x2C\x0d\n  kBoundSession\x2C\x0d\n  setStreamTimeout\x2C\x0d\n} = require('internal/stream_base_commons');\x0d\nconst { kTimeout } = require('internal/timers');\x0d\nconst { isArrayBufferView } = require('internal/util/types');\x0d\nconst { format } = require('internal/util/inspect');\x0d\n\x0d\nconst { FileHandle } = internalBinding('fs');\x0d\nconst binding = internalBinding('http2');\x0d\nconst {\x0d\n  ShutdownWrap\x2C\x0d\n  kReadBytesOrError\x2C\x0d\n  streamBaseState\x2C\x0d\n} = internalBinding('stream_wrap');\x0d\nconst { UV_EOF } = internalBinding('uv');\x0d\n\x0d\nconst { StreamPipe } = internalBinding('stream_pipe');\x0d\nconst { _connectionListener: httpConnectionListener } = http;\x0d\n\x0d\nconst dc = require('diagnostics_channel');\x0d\nconst onClientStreamCreatedChannel = dc.channel('http2.client.stream.created');\x0d\nconst onClientStreamStartChannel = dc.channel('http2.client.stream.start');\x0d\nconst onClientStreamErrorChannel = dc.channel('http2.client.stream.error');\x0d\nconst onClientStreamFinishChannel = dc.channel('http2.client.stream.finish');\x0d\nconst onClientStreamCloseChannel = dc.channel('http2.client.stream.close');\x0d\nconst onServerStreamCreatedChannel = dc.channel('http2.server.stream.created');\x0d\nconst onServerStreamStartChannel = dc.channel('http2.server.stream.start');\x0d\nconst onServerStreamErrorChannel = dc.channel('http2.server.stream.error');\x0d\nconst onServerStreamFinishChannel = dc.channel('http2.server.stream.finish');\x0d\nconst onServerStreamCloseChannel = dc.channel('http2.server.stream.close');\x0d\n\x0d\nlet debug = require('internal/util/debuglog').debuglog('http2'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst debugEnabled = debug.enabled;\x0d\n\x0d\nfunction debugStream(id\x2C sessionType\x2C message\x2C ...args) {\x0d\n  if (!debugEnabled) {\x0d\n    return;\x0d\n  }\x0d\n  debug('Http2Stream %s [Http2Session %s]: ' + message\x2C\x0d\n        id\x2C sessionName(sessionType)\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction debugStreamObj(stream\x2C message\x2C ...args) {\x0d\n  const session = stream[kSession];\x0d\n  const type = session ? session[kType] : undefined;\x0d\n  debugStream(stream[kID]\x2C type\x2C message\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction debugSession(sessionType\x2C message\x2C ...args) {\x0d\n  debug('Http2Session %s: ' + message\x2C sessionName(sessionType)\x2C\x0d\n        ...args);\x0d\n}\x0d\n\x0d\nfunction debugSessionObj(session\x2C message\x2C ...args) {\x0d\n  debugSession(session[kType]\x2C message\x2C ...args);\x0d\n}\x0d\n\x0d\nconst kMaxFrameSize = (2 ** 24) - 1;\x0d\nconst kMaxInt = (2 ** 32) - 1;\x0d\nconst kMaxStreams = (2 ** 32) - 1;\x0d\nconst kMaxALTSVC = (2 ** 14) - 2;\x0d\n\x0d\n// eslint-disable-next-line no-control-regex\x0d\nconst kQuotedString = /^[\\x09\\x20-\\x5b\\x5d-\\x7e\\x80-\\xff]*$/;\x0d\n\x0d\nconst { constants\x2C nameForErrorCode } = binding;\x0d\n\x0d\nconst NETServer = net.Server;\x0d\nconst TLSServer = tls.Server;\x0d\n\x0d\nconst kAlpnProtocol = Symbol('alpnProtocol');\x0d\nconst kEncrypted = Symbol('encrypted');\x0d\nconst kID = Symbol('id');\x0d\nconst kInit = Symbol('init');\x0d\nconst kInfoHeaders = Symbol('sent-info-headers');\x0d\nconst kLocalSettings = Symbol('local-settings');\x0d\nconst kNativeFields = Symbol('kNativeFields');\x0d\nconst kOptions = Symbol('options');\x0d\nconst kOwner = owner_symbol;\x0d\nconst kOrigin = Symbol('origin');\x0d\nconst kPendingRequestCalls = Symbol('kPendingRequestCalls');\x0d\nconst kProceed = Symbol('proceed');\x0d\nconst kRemoteSettings = Symbol('remote-settings');\x0d\nconst kRequestAsyncResource = Symbol('requestAsyncResource');\x0d\nconst kSentHeaders = Symbol('sent-headers');\x0d\nconst kRawHeaders = Symbol('raw-headers');\x0d\nconst kSentTrailers = Symbol('sent-trailers');\x0d\nconst kServer = Symbol('server');\x0d\nconst kState = Symbol('state');\x0d\nconst kType = Symbol('type');\x0d\nconst kWriteGeneric = Symbol('write-generic');\x0d\nconst kSessions = Symbol('sessions');\x0d\n\x0d\nconst {\x0d\n  kBitfield\x2C\x0d\n  kSessionPriorityListenerCount\x2C\x0d\n  kSessionFrameErrorListenerCount\x2C\x0d\n  kSessionMaxInvalidFrames\x2C\x0d\n  kSessionMaxRejectedStreams\x2C\x0d\n  kSessionUint8FieldCount\x2C\x0d\n  kSessionHasRemoteSettingsListeners\x2C\x0d\n  kSessionRemoteSettingsIsUpToDate\x2C\x0d\n  kSessionHasPingListeners\x2C\x0d\n  kSessionHasAltsvcListeners\x2C\x0d\n} = binding;\x0d\n\x0d\nconst {\x0d\n  NGHTTP2_CANCEL\x2C\x0d\n  NGHTTP2_REFUSED_STREAM\x2C\x0d\n  NGHTTP2_DEFAULT_WEIGHT\x2C\x0d\n  NGHTTP2_FLAG_END_STREAM\x2C\x0d\n  NGHTTP2_HCAT_PUSH_RESPONSE\x2C\x0d\n  NGHTTP2_HCAT_RESPONSE\x2C\x0d\n  NGHTTP2_INTERNAL_ERROR\x2C\x0d\n  NGHTTP2_NO_ERROR\x2C\x0