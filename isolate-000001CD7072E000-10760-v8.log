script-source,203,node:internal/dns/promises,'use strict';\x0d\nconst {\x0d\n  ArrayPrototypeMap\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  Promise\x2C\x0d\n  ReflectApply\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  bindDefaultResolver\x2C\x0d\n  createResolverClass\x2C\x0d\n  validateHints\x2C\x0d\n  emitInvalidHostnameWarning\x2C\x0d\n  errorCodes: dnsErrorCodes\x2C\x0d\n  getDefaultResultOrder\x2C\x0d\n  setDefaultResultOrder\x2C\x0d\n  setDefaultResolver\x2C\x0d\n  validDnsOrders\x2C\x0d\n  validFamilies\x2C\x0d\n} = require('internal/dns/utils');\x0d\n\x0d\nconst {\x0d\n  NODATA\x2C\x0d\n  FORMERR\x2C\x0d\n  SERVFAIL\x2C\x0d\n  NOTFOUND\x2C\x0d\n  NOTIMP\x2C\x0d\n  REFUSED\x2C\x0d\n  BADQUERY\x2C\x0d\n  BADNAME\x2C\x0d\n  BADFAMILY\x2C\x0d\n  BADRESP\x2C\x0d\n  CONNREFUSED\x2C\x0d\n  TIMEOUT\x2C\x0d\n  EOF\x2C\x0d\n  FILE\x2C\x0d\n  NOMEM\x2C\x0d\n  DESTRUCTION\x2C\x0d\n  BADSTR\x2C\x0d\n  BADFLAGS\x2C\x0d\n  NONAME\x2C\x0d\n  BADHINTS\x2C\x0d\n  NOTINITIALIZED\x2C\x0d\n  LOADIPHLPAPI\x2C\x0d\n  ADDRGETNETWORKPARAMS\x2C\x0d\n  CANCELLED\x2C\x0d\n} = dnsErrorCodes;\x0d\nconst {\x0d\n  DNSException\x2C\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_MISSING_ARGS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst { isIP } = require('internal/net');\x0d\nconst {\x0d\n  getaddrinfo\x2C\x0d\n  getnameinfo\x2C\x0d\n  GetAddrInfoReqWrap\x2C\x0d\n  GetNameInfoReqWrap\x2C\x0d\n  QueryReqWrap\x2C\x0d\n  DNS_ORDER_VERBATIM\x2C\x0d\n  DNS_ORDER_IPV4_FIRST\x2C\x0d\n  DNS_ORDER_IPV6_FIRST\x2C\x0d\n} = internalBinding('cares_wrap');\x0d\nconst {\x0d\n  validateBoolean\x2C\x0d\n  validateNumber\x2C\x0d\n  validateOneOf\x2C\x0d\n  validatePort\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst kPerfHooksDnsLookupContext = Symbol('kPerfHooksDnsLookupContext');\x0d\nconst kPerfHooksDnsLookupServiceContext = Symbol('kPerfHooksDnsLookupServiceContext');\x0d\nconst kPerfHooksDnsLookupResolveContext = Symbol('kPerfHooksDnsLookupResolveContext');\x0d\n\x0d\nconst {\x0d\n  hasObserver\x2C\x0d\n  startPerf\x2C\x0d\n  stopPerf\x2C\x0d\n} = require('internal/perf/observe');\x0d\n\x0d\nfunction onlookup(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    this.reject(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const family = this.family || isIP(addresses[0]);\x0d\n  this.resolve({ address: addresses[0]\x2C family });\x0d\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\x0d\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onlookupall(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    this.reject(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const family = this.family;\x0d\n\x0d\n  for (let i = 0; i < addresses.length; i++) {\x0d\n    const address = addresses[i];\x0d\n\x0d\n    addresses[i] = {\x0d\n      address\x2C\x0d\n      family: family || isIP(addresses[i])\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  this.resolve(addresses);\x0d\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\x0d\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates a promise that resolves with the IP address of the given hostname.\x0d\n * @param {0 | 4 | 6} family - The IP address family (4 or 6\x2C or 0 for both).\x0d\n * @param {string} hostname - The hostname to resolve.\x0d\n * @param {boolean} all - Whether to resolve with all IP addresses for the hostname.\x0d\n * @param {number} hints - One or more supported getaddrinfo flags (supply multiple via\x0d\n *   bitwise OR).\x0d\n * @param {number} dnsOrder - How to sort results. Must be `ipv4first`\x2C `ipv6first` or `verbatim`.\x0d\n * @returns {Promise<DNSLookupResult | DNSLookupResult[]>} The IP address(es) of the hostname.\x0d\n * 