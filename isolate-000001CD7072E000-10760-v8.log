script-source,272,node:internal/assert/utils,'use strict';\x0d\n\x0d\nconst {\x0d\n  Error\x2C\x0d\n  ErrorCaptureStackTrace\x2C\x0d\n  StringPrototypeCharCodeAt\x2C\x0d\n  StringPrototypeReplace\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  isErrorStackTraceLimitWritable\x2C\x0d\n} = require('internal/errors');\x0d\nconst AssertionError = require('internal/assert/assertion_error');\x0d\nconst { isError } = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  getErrorSourceExpression\x2C\x0d\n} = require('internal/errors/error_source');\x0d\n\x0d\n// Escape control characters but not \\n and \\t to keep the line breaks and\x0d\n// indentation intact.\x0d\n// eslint-disable-next-line no-control-regex\x0d\nconst escapeSequencesRegExp = /[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]/g;\x0d\nconst meta = [\x0d\n  '\\\\u0000'\x2C '\\\\u0001'\x2C '\\\\u0002'\x2C '\\\\u0003'\x2C '\\\\u0004'\x2C\x0d\n  '\\\\u0005'\x2C '\\\\u0006'\x2C '\\\\u0007'\x2C '\\\\b'\x2C ''\x2C\x0d\n  ''\x2C '\\\\u000b'\x2C '\\\\f'\x2C ''\x2C '\\\\u000e'\x2C\x0d\n  '\\\\u000f'\x2C '\\\\u0010'\x2C '\\\\u0011'\x2C '\\\\u0012'\x2C '\\\\u0013'\x2C\x0d\n  '\\\\u0014'\x2C '\\\\u0015'\x2C '\\\\u0016'\x2C '\\\\u0017'\x2C '\\\\u0018'\x2C\x0d\n  '\\\\u0019'\x2C '\\\\u001a'\x2C '\\\\u001b'\x2C '\\\\u001c'\x2C '\\\\u001d'\x2C\x0d\n  '\\\\u001e'\x2C '\\\\u001f'\x2C\x0d\n];\x0d\n\x0d\nconst escapeFn = (str) => meta[StringPrototypeCharCodeAt(str\x2C 0)];\x0d\n\x0d\nfunction getErrMessage(fn) {\x0d\n  const tmpLimit = Error.stackTraceLimit;\x0d\n  const errorStackTraceLimitIsWritable = isErrorStackTraceLimitWritable();\x0d\n  // Make sure the limit is set to 1. Otherwise it could fail (<= 0) or it\x0d\n  // does to much work.\x0d\n  if (errorStackTraceLimitIsWritable) Error.stackTraceLimit = 1;\x0d\n  // We only need the stack trace. To minimize the overhead use an object\x0d\n  // instead of an error.\x0d\n  const err = {};\x0d\n  ErrorCaptureStackTrace(err\x2C fn);\x0d\n  if (errorStackTraceLimitIsWritable) Error.stackTraceLimit = tmpLimit;\x0d\n\x0d\n  let source = getErrorSourceExpression(err);\x0d\n  if (source) {\x0d\n    source = StringPrototypeReplace(source\x2C escapeSequencesRegExp\x2C escapeFn);\x0d\n    return `The expression evaluated to a falsy value:\\n\\n  ${source}\\n`;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction innerOk(fn\x2C argLen\x2C value\x2C message) {\x0d\n  if (!value) {\x0d\n    let generatedMessage = false;\x0d\n\x0d\n    if (argLen === 0) {\x0d\n      generatedMessage = true;\x0d\n      message = 'No value argument passed to `assert.ok()`';\x0d\n    } else if (message == null) {\x0d\n      generatedMessage = true;\x0d\n      message = getErrMessage(fn);\x0d\n    } else if (isError(message)) {\x0d\n      throw message;\x0d\n    }\x0d\n\x0d\n    const err = new AssertionError({\x0d\n      actual: value\x2C\x0d\n      expected: true\x2C\x0d\n      message\x2C\x0d\n      operator: '=='\x2C\x0d\n      stackStartFn: fn\x2C\x0d\n    });\x0d\n    err.generatedMessage = generatedMessage;\x0d\n    throw err;\x0d\n  }\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  innerOk\x2C\x0d\n};\x0d\n
