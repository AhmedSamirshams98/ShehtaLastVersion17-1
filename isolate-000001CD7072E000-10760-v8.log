script-source,567,node:internal/util/comparisons,'use strict';\x0d\n\x0d\nconst {\x0d\n  Array\x2C\x0d\n  ArrayBuffer\x2C\x0d\n  ArrayIsArray\x2C\x0d\n  ArrayPrototypeFilter\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  BigInt\x2C\x0d\n  BigInt64Array\x2C\x0d\n  BigIntPrototypeValueOf\x2C\x0d\n  BigUint64Array\x2C\x0d\n  Boolean\x2C\x0d\n  BooleanPrototypeValueOf\x2C\x0d\n  DataView\x2C\x0d\n  Date\x2C\x0d\n  DatePrototypeGetTime\x2C\x0d\n  Error\x2C\x0d\n  Float32Array\x2C\x0d\n  Float64Array\x2C\x0d\n  Function\x2C\x0d\n  Int16Array\x2C\x0d\n  Int32Array\x2C\x0d\n  Int8Array\x2C\x0d\n  Map\x2C\x0d\n  Number\x2C\x0d\n  NumberPrototypeValueOf\x2C\x0d\n  Object\x2C\x0d\n  ObjectGetOwnPropertyDescriptor\x2C\x0d\n  ObjectGetOwnPropertySymbols: getOwnSymbols\x2C\x0d\n  ObjectGetPrototypeOf\x2C\x0d\n  ObjectIs\x2C\x0d\n  ObjectKeys\x2C\x0d\n  ObjectPrototypeHasOwnProperty: hasOwn\x2C\x0d\n  ObjectPrototypePropertyIsEnumerable: hasEnumerable\x2C\x0d\n  ObjectPrototypeToString\x2C\x0d\n  Promise\x2C\x0d\n  RegExp\x2C\x0d\n  SafeSet\x2C\x0d\n  Set\x2C\x0d\n  String\x2C\x0d\n  StringPrototypeValueOf\x2C\x0d\n  Symbol\x2C\x0d\n  SymbolPrototypeValueOf\x2C\x0d\n  TypedArrayPrototypeGetByteLength: getByteLength\x2C\x0d\n  TypedArrayPrototypeGetSymbolToStringTag\x2C\x0d\n  Uint16Array\x2C\x0d\n  Uint32Array\x2C\x0d\n  Uint8Array\x2C\x0d\n  Uint8ClampedArray\x2C\x0d\n  WeakMap\x2C\x0d\n  WeakSet\x2C\x0d\n  globalThis: { Float16Array }\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst { compare } = internalBinding('buffer');\x0d\nconst assert = require('internal/assert');\x0d\nconst { isURL } = require('internal/url');\x0d\nconst { isError } = require('internal/util');\x0d\nconst { Buffer } = require('buffer');\x0d\n\x0d\nconst wellKnownConstructors = new SafeSet()\x0d\n  .add(Array)\x0d\n  .add(ArrayBuffer)\x0d\n  .add(BigInt)\x0d\n  .add(BigInt64Array)\x0d\n  .add(BigUint64Array)\x0d\n  .add(Boolean)\x0d\n  .add(Buffer)\x0d\n  .add(DataView)\x0d\n  .add(Date)\x0d\n  .add(Error)\x0d\n  .add(