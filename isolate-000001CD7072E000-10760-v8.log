eUnit && codeUnit <= 0xDBFF) {\x0d\n            this.#pendingHighSurrogate = item;\x0d\n            continue;\x0d\n          }\x0d\n          if (0xDC00 <= codeUnit && codeUnit <= 0xDFFF) {\x0d\n            finalChunk += '\\uFFFD';\x0d\n            continue;\x0d\n          }\x0d\n          finalChunk += item;\x0d\n        }\x0d\n        if (finalChunk) {\x0d\n          const value = this.#handle.encode(finalChunk);\x0d\n          controller.enqueue(value);\x0d\n        }\x0d\n      }\x2C\x0d\n      flush: (controller) => {\x0d\n        // https://encoding.spec.whatwg.org/#encode-and-flush\x0d\n        if (this.#pendingHighSurrogate !== null) {\x0d\n          controller.enqueue(new Uint8Array([0xEF\x2C 0xBF\x2C 0xBD]));\x0d\n        }\x0d\n      }\x2C\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @readonly\x0d\n   * @type {string}\x0d\n   */\x0d\n  get encoding() {\x0d\n    return this.#handle.encoding;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @readonly\x0d\n   * @type {ReadableStream}\x0d\n   */\x0d\n  get readable() {\x0d\n    return this.#transform.readable;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @readonly\x0d\n   * @type {WritableStream}\x0d\n   */\x0d\n  get writable() {\x0d\n    return this.#transform.writable;\x0d\n  }\x0d\n\x0d\n  [kInspect](depth\x2C options) {\x0d\n    if (this == null)\x0d\n      throw new ERR_INVALID_THIS('TextEncoderStream');\x0d\n    return customInspect(depth\x2C options\x2C 'TextEncoderStream'\x2C {\x0d\n      encoding: this.#handle.encoding\x2C\x0d\n      readable: this.#transform.readable\x2C\x0d\n      writable: this.#transform.writable\x2C\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\nclass TextDecoderStream {\x0d\n  #handle;\x0d\n  #transform;\x0d\n\x0d\n  /**\x0d\n   * @param {string} [encoding]\x0d\n   * @param {{\x0d\n   *   fatal? : boolean\x2C\x0d\n   *   ignoreBOM? : boolean\x2C\x0d\n   * }} [options]\x0d\n   */\x0d\n  constructor(encoding = 'utf-8'\x2C options = kEmptyObject) {\x0d\n    this.#handle = new TextDecoder(encoding\x2C opt