script-source,335,node:v8,// Copyright (c) 2014\x2C StrongLoop Inc.\x0d\n//\x0d\n// Permission to use\x2C copy\x2C modify\x2C and/or distribute this software for any\x0d\n// purpose with or without fee is hereby granted\x2C provided that the above\x0d\n// copyright notice and this permission notice appear in all copies.\x0d\n//\x0d\n// THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES\x0d\n// WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF\x0d\n// MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR\x0d\n// ANY SPECIAL\x2C DIRECT\x2C INDIRECT\x2C OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\x0d\n// WHATSOEVER RESULTING FROM LOSS OF USE\x2C DATA OR PROFITS\x2C WHETHER IN AN\x0d\n// ACTION OF CONTRACT\x2C NEGLIGENCE OR OTHER TORTIOUS ACTION\x2C ARISING OUT OF\x0d\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst {\x0d\n  Array\x2C\x0d\n  BigInt64Array\x2C\x0d\n  BigUint64Array\x2C\x0d\n  DataView\x2C\x0d\n  Error\x2C\x0d\n  Float32Array\x2C\x0d\n  Float64Array\x2C\x0d\n  Int16Array\x2C\x0d\n  Int32Array\x2C\x0d\n  Int8Array\x2C\x0d\n  JSONParse\x2C\x0d\n  ObjectPrototypeToString\x2C\x0d\n  Uint16Array\x2C\x0d\n  Uint32Array\x2C\x0d\n  Uint8Array\x2C\x0d\n  Uint8ClampedArray\x2C\x0d\n  globalThis: {\x0d\n    Float16Array\x2C\x0d\n  }\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst { Buffer } = require('buffer');\x0d\nconst {\x0d\n  validateString\x2C\x0d\n  validateUint32\x2C\x0d\n  validateOneOf\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  Serializer\x2C\x0d\n  Deserializer\x2C\x0d\n} = internalBinding('serdes');\x0d\nconst {\x0d\n  namespace: startupSnapshot\x2C\x0d\n} = require('internal/v8/startup_snapshot');\x0d\n\x0d\nlet profiler = {};\x0d\nif (internalBinding('config').hasInspector) {\x0d\n  profiler = internalBinding('profiler');\x0d\n}\x0d\n\x0d\nconst assert = require('internal/assert');\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\nconst { FastBuffer } = require('internal/buffer');\x0d\nconst { getValidatedPath } = require('internal/fs/utils');\x0d\nconst {\x0d\n  createHeapSnapshotStream\x2C\x0d\n  triggerHeapSnapshot\x2C\x0d\n} = internalBinding('heap_utils');\x0d\nconst {\x0d\n  HeapSnapshotStream\x2C\x0d\n  getHeapSnapshotOptions\x2C\x0d\n  queryObjects\x2C\x0d\n} = require('internal/heap_utils');\x0d\nconst promiseHooks = require('internal/promise_hooks');\x0d\nconst { getOptionValue } = require('internal/options');\x0d\n\x0d\n/**\x0d\n * Generates a snapshot of the current V8 heap\x0d\n * and writes it to a JSON file.\x0d\n * @param {string} [filename]\x0d\n * @param {{\x0d\n *   exposeInternals?: boolean\x2C\x0d\n *   exposeNumericValues?: boolean\x0d\n * }} [options]\x0d\n * @returns {string}\x0d\n */\x0d\nfunction writeHeapSnapshot(filename\x2C options) {\x0d\n  if (filename !== undefined) {\x0d\n    filename = getValidatedPath(filename);\x0d\n  }\x0d\n  const optionArray = getHeapSnapshotOptions(options);\x0d\n  return triggerHeapSnapshot(filename\x2C optionArray);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Generates a snapshot of the current V8 heap\x0d\n * and returns a Readable Stream.\x0d\n * @param {{\x0d\n *   exposeInternals?: boolean\x2C\x0d\n *   exposeNumericValues?: boolean\x0d\n * }} [options]\x0d\n * @returns {import('./stream.js').Readable}\x0d\n */\x0d\nfunction getHeapSnapshot(options) {\x0d\n  const optionArray = getHeapSnapshotOptions(options);\x0d\n  const handle = createHeapSnapshotStream(optionArray);\x0d\n  assert(handle);\x0d\n  return new HeapSnapshotStream(handle);\x0d\n}\x0d\n\x0d\n// We need to get the buffer from the binding at the callsite since\x0d\n// it's re-initialized after deserialization.\x0d\nconst binding = internalBinding('v8');\x0d\n\x0d\nconst {\x0d\n  cachedDataVersionTag\x2C\x0d\n  setFlagsFromString: _setFlagsFromString\x2C\x0d\n  isStringOneByteRepresentation: _isStringOneByteRepresentation\x2C\x0d\n  updateHeapStatisticsBuffer\x2C\x0d\n  updateHeapSpaceStatisticsBuffer\x2C\x0d\n  updateHeapCodeStatisticsBuffer\x2C\x0d\n  setHeapSnapshotNearHeapLimit: _setHeapSnapshotNearHeapLimit\x2C\x0d\n\x0d\n  // Properties for heap statistics buffer extraction.\x0d\n  kTotalHeapSizeIndex\x2C\x0d\n  kTotalHeapSizeExecutableIndex\x2C\x0d\n  kTotalPhysicalSizeIndex\x2C\x0d\n  kTotalAvailableSize\x2C\x0d\n  kUsedHeapSizeIndex\x2C\x0d\n  kHeapSizeLimitIndex\x2C\x0d\n  kDoesZapGarbageIndex\x2C\x0d\n  kMallocedMemoryIndex\x2C\x0d\n  kPeakMallocedMemoryIndex\x2C\x0d\n  kNumberOfNativeContextsIndex\x2C\x0d\n  kNumberOfDetachedContextsIndex\x2C\x0d\n  kTotalGlobalHandlesSizeIndex\x2C\x0d\n  kUsedGlobalHandlesSizeIndex\x2C\x0d\n  kExternalMemoryIndex\x2C\x0d\n\x0d\n  // Properties for heap spaces statistics buffer extraction.\x0d\n  kHeapSpaces\x2C\x0d\n  kSpaceSizeIndex\x2C\x0d\n  kSpaceUsedSizeIndex\x2C\x0d\n  kSpaceAvailableSizeIndex\x2C\x0d\n  kPhysicalSpaceSizeIndex\x2C\x0d\n\x0d\n  // Properties for heap code statistics buffer extraction.\x0d\n  kCodeAndMetadataSizeIndex\x2C\x0d\n  kBytecodeAndMetadataSizeIndex\x2C\x0d\n  kExternalScriptSourceSizeIndex\x2C\x0d\n  kCPUProfilerMetaDataSizeIndex\x2C\x0d\n\x0d\n  heapStatisticsBuffer\x2C\x0d\n  heapCodeStatisticsBuffer\x2C\x0d\n  heapSpaceStatisticsBuffer\x2C\x0d\n  getCppHeapStatistics: _getCppHeapStatistics\x2C\x0d\n  detailLevel\x2C\x0d\n} = binding;\x0d\n\x0d\nconst kNumberOfHeapSpaces = kHeapSpaces.length;\x0d\n\x0d\n/**\x0d\n * Sets V8 command-line flags.\x0d\n * @param {string} flags\x0d\n * @returns {void}\x0d\n */\x0d\nfunction setFlagsFromString(flags) {\x0d\n  validateString(flags\x2C 'flags');\x0d\n  _setFlagsFromString(flags);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Return whether this string uses one byte as underlying representation or not.\x0d\n * @param {string} content\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction isStringOneByteRepresentation(content) {\x0d\n  validateString(content\x2C 'content');\x0d\n  return _isStringOneByteRepresentation(content);\x0d\n}\x0d\n\x0d\n\x0d\n/**\x0d\n * Gets the current V8 heap statistics.\x0d\n * @returns {{\x0d\n *   total_heap_size: number;\x0d\n *   total_heap_size_executable: number;\x0d\n *   total_physical_size: number;\x0d\n *   total_available_size: number;\x0d\n *   used_heap_size: number;\x0d\n *   heap_size_limit: number;\x0d\n *   malloced_memory: number;\x0d\n *   peak_malloced_memory: number;\x0d\n *   does_zap_garbage: number;\x0d\n *   number_of_native_contexts: number;\x0d\n *   number_of_detached_contexts: number;\x0d\n *   }}\x0d\n */\x0d\nfunction getHeapStatistics() {\x0d\n  const buffer = heapStatisticsBuffer;\x0d\n\x0d\n  updateHeapStatisticsBuffer();\x0d\n\x0d\n  return {\x0d\n    total_heap_size: buffer[kTotalHeapSizeIndex]\x2C\x0d\n    total_heap_size_executable: buffer[kTotalHeapSizeExecutableIndex]\x2C\x0d\n    total_physical_size: buffer[kTotalPhysicalSizeIndex]\x2C\x0d\n    total_available_size: buffer[kTotalAvailableSize]\x2C\x0d\n    used_heap_size: buffer[kUsedHeapSizeIndex]\x2C\x0d\n    heap_size_limit: buffer[kHeapSizeLimitIndex]\x2C\x0d\n    malloced_memory: buffer[kMallocedMemoryIndex]\x2C\x0d\n    peak_malloced_memory: buffer[kPeakMallocedMemoryIndex]\x2C\x0d\n    does_zap_garbage: buffer[kDoesZapGarbageIndex]\x2C\x0d\n    number_of_native_contexts: buffer[kNumberOfNativeContextsIndex]\x2C\x0d\n    number_of_detached_contexts: buffer[kNumberOfDetachedContextsIndex]\x2C\x0d\n    total_global_handles_size: buffer[kTotalGlobalHandlesSizeIndex]\x2C\x0d\n    used_global_handles_size: buffer[kUsedGlobalHandlesSizeIndex]\x2C\x0d\n    external_memory: buffer[kExternalMemoryIndex]\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n/**\x0d\n * Gets the current V8 heap space statistics.\x0d\n * @returns {{\x0d\n *   space_name: string;\x0d\n *   space_size: number;\x0d\n *   space_used_size: number;\x0d\n *   space_available_size: number;\x0d\n *   physical_space_size: number;\x0d\n *   }[]}\x0d\n */\x0d\nfunction getHeapSpaceStatistics() {\x0d\n  const heapSpaceStatistics = new Array(kNumberOfHeapSpaces);\x0d\n  const buffer = heapSpaceStatisticsBuffer;\x0d\n\x0d\n  for (let i = 0; i < kNumberOfHeapSpaces; i++) {\x0d\n    updateHeapSpaceStatisticsBuffer(i);\x0d\n    heapSpaceStatistics[i] = {\x0d\n      space_name: kHeapSpaces[i]\x2C\x0d\n      space_size: buffer[kSpaceSizeIndex]\x2C\x0d\n      space_used_size: buffer[kSpaceUsedSizeIndex]\x2C\x0d\n      space_available_size: buffer[kSpaceAvailableSizeIndex]\x2C\x0d\n      physical_space_size: buffer[kPhysicalSpaceSizeIndex]\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  return heapSpaceStatistics;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Gets the current V8 heap code statistics.\x0d\n * @returns {{\x0d\n *   code_and_metadata_size: number;\x0d\n *   bytecode_and_metadata_size: number;\x0d\n *   external_script_source_size: number;\x0d\n *   cpu_profiler_metadata_size: number;\x0d\n *   }}\x0d\n */\x0d\nfunction getHeapCodeStatistics() {\x0d\n  const buffer = heapCodeStatisticsBuffer;\x0d\n\x0d\n  updateHeapCodeStatisticsBuffer();\x0d\n  return {\x0d\n    code_and_metadata_size: buffer[kCodeAndMetadataSizeIndex]\x2C\x0d\n    bytecode_and_metadata_size: buffer[kBytecodeAndMetadataSizeIndex]\x2C\x0d\n    external_script_source_size: buffer[kExternalScriptSourceSizeIndex]\x2C\x0d\n    cpu_profiler_metadata_size: buffer[kCPUProfilerMetaDataSizeIndex]\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\nlet heapSnapshotNearHeapLimitCallbackAdded = false;\x0d\nfunction setHeapSnapshotNearHeapLimit(limit) {\x0d\n  validateUint32(limit\x2C 'limit'\x2C true);\x0d\n  if (heapSnapshotNearHeapLimitCallbackAdded ||\x0d\n      getOptionValue('--heapsnapshot-near-heap-limit') > 0\x0d\n  ) {\x0d\n    return;\x0d\n  }\x0d\n  heapSnapshotNearHeapLimitCallbackAdded = true;\x0d\n  _setHeapSnapshotNearHeapLimit(limit);\x0d\n}\x0d\n\x0d\nconst detailLevelDict = {\x0d\n  __proto__: null\x2C\x0d\n  detailed: detailLevel.DETAILED\x2C\x0d\n  brief: detailLevel.BRIEF\x2C\x0d\n};\x0d\n\x0d\nfunction getCppHeapStatistics(type = 'detailed') {\x0d\n  validateOneOf(type\x2C 'type'\x2C ['brief'\x2C 'detailed']);\x0d\n  const result = _getCppHeapStatistics(detailLevelDict[type]);\x0d\n  result.detail_level = type;\x0d\n  return result;\x0d\n}\x0d\n\x0d\n/* V8 serialization API */\x0d\n\x0d\n/* JS methods for the base objects */\x0d\nSerializer.prototype._getDataCloneError = Error;\x0d\n\x0d\n/**\x0d\n * Reads raw bytes from the deserializer's internal buffer.\x0d\n * @param {number} length\x0d\n * @returns {Buffer}\x0d\n */\x0d\nDeserializer.prototype.readRawBytes = function readRawBytes(length) {\x0d\n  const offset = this._readRawBytes(length);\x0d\n  // `this.buffer` can be a Buffer or a plain Uint8Array\x2C so just calling\x0d\n  // `.slice()` doesn't work.\x0d\n  return new FastBuffer(this.buffer.buffer\x2C\x0d\n                        this.buffer.byteOffset + offset\x2C\x0d\n                        length);\x0d\n};\x0d\n\x0d\nfunction arrayBufferViewTypeToIndex(abView) {\x0d\n  const type = ObjectPrototypeToString(abView);\x0d\n  if (type === '[object Int8Array]') return 0;\x0d\n  if (type === '[object Uint8Array]') return 1;\x0d\n  if (type === '[object Uint8ClampedArray]') return 2;\x0d\n  if (type === '[object Int16Array]') return 3;\x0d\n  if (type === '[object Uint16Array]') return 4;\x0d\n  if (type === '[object Int32Array]') return 5;\x0d\n  if (type === '[object Uint32Array]') return 6;\x0d\n  if (type === '[object Float32Array]') return 7;\x0d\n  if (type === '[object Float64Array]') return 8;\x0d\n  if (type === '[object DataView]') return 9;\x0d\n  // Index 10 is FastBuffer.\x0d\n  if (type === '[object BigInt64Array]') return 11;\x0d\n  if (type === '[object BigUint64Array]') return 12;\x0d\n  if (type === '[object Float16Array]') return 13;\x0d\n  return -1;\x0d\n}\x0d\n\x0d\nfunction arrayBufferViewIndexToType(index) {\x0d\n  if (index === 0) return Int8Array;\x0d\n  if (index === 1) return Uint8Array;\x0d\n  if (index === 2) return Uint8ClampedArray;\x0d\n  if (index === 3) return Int16Array;\x0d\n  if (index === 4) return Uint16Array;\x0d\n  if (index === 5) return Int32Array;\x0d\n  if (index === 6) return Uint32Array;\x0d\n  if (index === 7) return Float32Array;\x0d\n  if (index === 8) return Float64Array;\x0d\n  if (index === 9) return DataView;\x0d\n  if (index === 10) return FastBuffer;\x0d\n  if (index === 11) return BigInt64Array;\x0d\n  if (index === 12) return BigUint64Array;\x0d\n  if (index === 13) return Float16Array;\x0d\n  return undefined;\x0d\n}\x0d\n\x0d\nclass DefaultSerializer extends Serializer {\x0d\n  constructor() {\x0d\n    super();\x0d\n\x0d\n    this._setTreatArrayBufferViewsAsHostObjects(true);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Used to write some kind of host object\x2C i.e. an\x0d\n   * object that is created by native C++ bindings.\x0d\n   * @param {object} abView\x0d\n   * @returns {void}\x0d\n   */\x0d\n  _writeHostObject(abView) {\x0d\n    // Keep track of how to handle different ArrayBufferViews. The default\x0d\n    // Serializer for Node does not use the V8 methods for serializing those\x0d\n    // objects because Node's `Buffer` objects use pooled allocation in many\x0d\n    // cases\x2C and their underlying `ArrayBuffer`s would show up in the\x0d\n    // serialization. Because a) those may contain sensitive data and the user\x0d\n    // may not be aware of that and b) they are often much larger than the\x0d\n    // `Buffer` itself\x2C custom serialization is applied.\x0d\n    let i = 10;  // FastBuffer\x0d\n    if (abView.constructor !== Buffer) {\x0d\n      i = arrayBufferViewTypeToIndex(abView);\x0d\n      if (i === -1) {\x0d\n        throw new this._getDataCloneError(\x0d\n          `Unserializable host object: ${inspect(abView)}`);\x0d\n      }\x0d\n    }\x0d\n    this.writeUint32(i);\x0d\n    this.writeUint32(abView.byteLength);\x0d\n    this.writeRawBytes(new Uint8Array(abView.buffer\x2C\x0d\n                                      abView.byteOffset\x2C\x0d\n                                      abView.byteLength));\x0d\n  }\x0d\n}\x0d\n\x0d\nclass DefaultDeserializer extends Deserializer {\x0d\n  /**\x0d\n   * Used to read some kind of host object\x2C i.e. an\x0d\n   * object that is created by native C++ bindings.\x0d\n   * @returns {any}\x0d\n   */\x0d\n  _readHostObject() {\x0d\n    const typeIndex = this.readUint32();\x0d\n    const ctor = arrayBufferViewIndexToType(typeIndex);\x0d\n    const byteLength = this.readUint32();\x0d\n    const byteOffset = this._readRawBytes(byteLength);\x0d\n    const BYTES_PER_ELEMENT = ctor.BYTES_PER_ELEMENT || 1;\x0d\n\x0d\n    const offset = this.buffer.byteOffset + byteOffset;\x0d\n    if (offset % BYTES_PER_ELEMENT === 0) {\x0d\n      return new ctor(this.buffer.buffer\x2C\x0d\n                      offset\x2C\x0d\n                      byteLength / BYTES_PER_ELEMENT);\x0d\n    }\x0d\n    // Copy to an aligned buffer first.\x0d\n    const buffer_copy = Buffer.allocUnsafe(byteLength);\x0d\n    buffer_copy.set(new Uint8Array(this.buffer.buffer\x2C this.buffer.byteOffset + byteOffset\x2C byteLength));\x0d\n    return new ctor(buffer_copy.buffer\x2C\x0d\n                    buffer_copy.byteOffset\x2C\x0d\n                    byteLength / BYTES_PER_ELEMENT);\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Uses a `DefaultSerializer` to serialize `value`\x0d\n * into a buffer.\x0d\n * @param {any} value\x0d\n * @returns {Buffer}\x0d\n */\x0d\nfunction serialize(value) {\x0d\n  const ser = new DefaultSerializer();\x0d\n  ser.writeHeader();\x0d\n  ser.writeValue(value);\x0d\n  return ser.releaseBuffer();\x0d\n}\x0d\n\x0d\n/**\x0d\n * Uses a `DefaultDeserializer` with default options\x0d\n * to read a JavaScript value from a buffer.\x0d\n * @param {Buffer | TypedArray | DataView} buffer\x0d\n * @returns {any}\x0d\n */\x0d\nfunction deserialize(buffer) {\x0d\n  const der = new DefaultDeserializer(buffer);\x0d\n  der.readHeader();\x0d\n  return der.readValue();\x0d\n}\x0d\n\x0d\nclass GCProfiler {\x0d\n  #profiler = null;\x0d\n\x0d\n  start() {\x0d\n   