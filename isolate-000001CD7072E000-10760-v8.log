script-source,304,node:internal/webstreams/compression,'use strict';\x0d\n\x0d\nconst {\x0d\n  ObjectDefineProperties\x2C\x0d\n  SymbolToStringTag\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  newReadableWritablePairFromDuplex\x2C\x0d\n} = require('internal/webstreams/adapters');\x0d\n\x0d\nconst { customInspect } = require('internal/webstreams/util');\x0d\n\x0d\nconst {\x0d\n  customInspectSymbol: kInspect\x2C\x0d\n  kEnumerableProperty\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst { createEnumConverter } = require('internal/webidl');\x0d\n\x0d\nlet zlib;\x0d\nfunction lazyZlib() {\x0d\n  zlib ??= require('zlib');\x0d\n  return zlib;\x0d\n}\x0d\n\x0d\nconst formatConverter = createEnumConverter('CompressionFormat'\x2C [\x0d\n  'deflate'\x2C\x0d\n  'deflate-raw'\x2C\x0d\n  'gzip'\x2C\x0d\n  'brotli'\x2C\x0d\n]);\x0d\n\x0d\n/**\x0d\n * @typedef {import('./readablestream').ReadableStream} ReadableStream\x0d\n * @typedef {import('./writablestream').WritableStream} WritableStream\x0d\n */\x0d\n\x0d\nclass CompressionStream {\x0d\n  #handle;\x0d\n  #transform;\x0d\n\x0d\n  /**\x0d\n   * @param {'deflate'|'deflate-raw'|'gzip'|'brotli'} format\x0d\n   */\x0d\n  constructor(format) {\x0d\n    format = formatConverter(format\x2C {\x0d\n      prefix: "Failed to construct 'CompressionStream'"\x2C\x0d\n      context: '1st argument'\x2C\x0d\n    });\x0d\n    switch (format) {\x0d\n      case 'deflate':\x0d\n        this.#handle = lazyZlib().createDeflate();\x0d\n        break;\x0d\n      case 'deflate-raw':\x0d\n        this.#handle = lazyZlib().createDeflateRaw();\x0d\n        break;\x0d\n      case 'gzip':\x0d\n        this.#handle = lazyZlib().createGzip();\x0d\n        break;\x0d\n      case 'brotli':\x0d\n        this.#handle = lazyZlib().createBrotliCompress();\x0d\n        break;\x0d\n    }\x0d\n    this.#transform = newReadableWritablePairFromDuplex(this.#handle);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @readonly\x0d\n   * @type {ReadableStream}\x0d\n   */\x0d\n  get readable() {\x0d\n    return this.#transform.readable;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @readonly\x0d\n   * @type {WritableStream}\x0d\n   */\x0d\n  get writable() {\x0d\n    return this.#transform.writable;\x0d\n  }\x0d\n\x0d\n  [kInspect](depth\x2C options) {\x0d\n    return customInspect(depth\x2C options\x2C 'CompressionStream'\x2C {\x0d\n      readable: this.#transform.readable\x2C\x0d\n      writable: this.#transform.writable\x2C\x0d\n    });\x0d\n  }\x0d\n}\x0d\n\x0d\nclass DecompressionStream {\x0d\n  #handle;\x0d\n  #transform;\x0d\n\x0d\n  /**\x0d\n   * @param {'deflate'|'deflate-raw'|'gzip'|'brotli'} format\x0d\n   */\x0d\n  constructor(format) {\x0d\n    format = formatConverter(format\x2C {\x0d\n      prefix: "Failed to construct 'DecompressionStream'"\x2C\x0d\n      context: '1st argument'\x2C\x0d\n    });\x0d\n    switch (format) {\x0d\n      case 'deflate':\x0d\n        this.#handle = lazyZlib().createInflate({\x0d\n          rejectGarbageAfterEnd: true\x2C\x0d\n        });\x0d\n        break;\x0d\n      case 'deflate-raw':\x0d\n        this.#handle = lazyZlib().createInflateRaw();\x0d\n        break;\x0d\n      case 'gzip':\x0d\n        this.#handle = lazyZlib().createGunzip({\x0d\n          rejectGarbageAfterEnd: true\x2C\x0d\n        });\x0d\n        break;\x0d\n      case 'brotli':\x0d\n        this.#handle = lazyZlib().createBrotliDecompress();\x0d\n        break;\x0d\n    }\x0d\n    this.#transform = newReadableWritablePairFromDuplex(this.#handle);\x0d\n\x0d\n    this.#handle.on('error'\x2C (err) => {\x0d\n      if (this.#transform?.writable &&\x0d\n        !this.#transform.writable.locked &&\x0d\n        typeof this.#transform.writable.abort === 'function') {\x0d\n        this.#transform.writable.abort(err);\x0d\n      }\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @readonly\x0d\n   * @type {ReadableStream}\x0d\n   */\x0d\n  get readable() {\x0d\n    return this.#transform.readable;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @readonly