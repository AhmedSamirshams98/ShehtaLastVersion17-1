p2Stream instance and emit the 'stream'\x0d\n// event. If the stream is not new\x2C emit the 'headers' event to pass\x0d\n// the block of headers on.\x0d\nfunction onSessionHeaders(handle\x2C id\x2C cat\x2C flags\x2C headers\x2C sensitiveHeaders) {\x0d\n  const session = this[kOwner];\x0d\n  if (session.destroyed)\x0d\n    return;\x0d\n\x0d\n  const type = session[kType];\x0d\n  session[kUpdateTimer]();\x0d\n  debugStream(id\x2C type\x2C 'headers received');\x0d\n  const streams = session[kState].streams;\x0d\n\x0d\n  const endOfStream = !!(flags & NGHTTP2_FLAG_END_STREAM);\x0d\n  let stream = streams.get(id);\x0d\n\x0d\n  // Convert the array of header name value pairs into an object\x0d\n  const obj = toHeaderObject(headers\x2C sensitiveHeaders);\x0d\n\x0d\n  if (stream === undefined) {\x0d\n    if (session.closed) {\x0d\n      // We are not accepting any new streams at this point. This callback\x0d\n      // should not be invoked at this point in time\x2C but just in case it is\x2C\x0d\n      // refuse the stream using an RST_STREAM and destroy the handle.\x0d\n      handle.rstStream(NGHTTP2_REFUSED_STREAM);\x0d\n      handle.destroy();\x0d\n      return;\x0d\n    }\x0d\n    // session[kType] can be only one of two possible values\x0d\n    if (type === NGHTTP2_SESSION_SERVER) {\x0d\n      // eslint-disable-next-line no-use-before-define\x0d\n      stream = new ServerHttp2Stream(session\x2C handle\x2C id\x2C {}\x2C obj);\x0d\n      if (onServerStreamCreatedChannel.hasSubscribers) {\x0d\n        onServerStreamCreatedChannel.publish({\x0d\n          stream\x2C\x0d\n          headers: obj\x2C\x0d\n        });\x0d\n      }\x0d\n      if (onServerStreamStartChannel.hasSubscribers) {\x0d\n        onServerStreamStartChannel.publish({\x0d\n          stream\x2C\x0d\n          headers: obj\x2C\x0d\n        });\x0d\n      }\x0d\n      if (endOfStream) {\x0d\n        stream.push(null);\x0d\n      }\x0d\n      if (obj[HTTP2_HEADER_METHOD] === HTTP2_METHOD_HEAD) {\x0d\n        