 = require('_http_common');\x0d\nconst {\x0d\n  kUniqueHeaders\x2C\x0d\n  parseUniqueHeadersOption\x2C\x0d\n  OutgoingMessage\x2C\x0d\n} = require('_http_outgoing');\x0d\nconst Agent = require('_http_agent');\x0d\nconst { Buffer } = require('buffer');\x0d\nconst { defaultTriggerAsyncIdScope } = require('internal/async_hooks');\x0d\nconst { URL\x2C urlToHttpOptions\x2C isURL } = require('internal/url');\x0d\nconst {\x0d\n  kOutHeaders\x2C\x0d\n  kNeedDrain\x2C\x0d\n  isTraceHTTPEnabled\x2C\x0d\n  traceBegin\x2C\x0d\n  traceEnd\x2C\x0d\n  getNextTraceEventId\x2C\x0d\n  kProxyConfig\x2C\x0d\n  checkShouldUseProxy\x2C\x0d\n} = require('internal/http');\x0d\nconst {\x0d\n  ConnResetException\x2C\x0d\n  codes: {\x0d\n    ERR_HTTP_HEADERS_SENT\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_HTTP_TOKEN\x2C\x0d\n    ERR_INVALID_PROTOCOL\x2C\x0d\n    ERR_UNESCAPED_CHARACTERS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  validateInteger\x2C\x0d\n  validateBoolean\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\nconst { getTimerDuration } = require('internal/timers');\x0d\nconst {\x0d\n  hasObserver\x2C\x0d\n  startPerf\x2C\x0d\n  stopPerf\x2C\x0d\n} = require('internal/perf/observe');\x0d\n\x0d\nconst kClientRequestStatistics = Symbol('ClientRequestStatistics');\x0d\n\x0d\nconst dc = require('diagnostics_channel');\x0d\nconst onClientRequestCreatedChannel = dc.channel('http.client.request.created');\x0d\nconst onClientRequestStartChannel = dc.channel('http.client.request.start');\x0d\nconst onClientRequestErrorChannel = dc.channel('http.client.request.error');\x0d\nconst onClientResponseFinishChannel = dc.channel('http.client.response.finish');\x0d\n\x0d\nfunction emitErrorEvent(request\x2C error) {\x0d\n  if (onClientRequestErrorChannel.hasSubscribers) {\x0d\n    onClientRequestErrorChannel.publish({\x0d\n      request\x2C\x0d\n      error\x2C\x0d\n    });\x0d\n  }\x0d\n  request.emit('error'\x2C error);\x0d\n}\x0d\n\x0d\nconst { addAbortSignal\x2C finished } = require('stream');\x0d\n\x0d\nlet debug = require('internal/util/debuglog').debuglog('http'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\n\x0d\nconst INVALID_PATH_REGEX = /[^\\u0021-\\u00ff]/;\x0d\nconst kError = Symbol('kError');\x0d\n\x0d\nconst kLenientAll = HTTPParser.kLenientAll | 0;\x0d\nconst kLenientNone = HTTPParser.kLenientNone | 0;\x0d\n\x0d\nconst HTTP_CLIENT_TRACE_EVENT_NAME = 'http.client.request';\x0d\n\x0d\nfunction validateHost(host\x2C name) {\x0d\n  if (host !== null && host !== undefined && typeof host !== 'string') {\x0d\n    throw new ERR_INVALID_ARG_TYPE(`options.${name}`\x2C\x0d\n                                   ['string'\x2C 'undefined'\x2C 'null']\x2C\x0d\n                                   host);\x0d\n  }\x0d\n  return host;\x0d\n}\x0d\n\x0d\nclass HTTPClientAsyncResource {\x0d\n  constructor(type\x2C req) {\x0d\n    this.type = type;\x0d\n    this.req = req;\x0d\n  }\x0d\n}\x0d\n\x0d\n// When proxying a HTTP request\x2C the following needs to be done:\x0d\n// https://datatracker.ietf.org/doc/html/rfc7230#section-5.3.2\x0d\n// 1. Rewrite the request path to absolute-form.\x0d\n// 2. Add proxy-connection and proxy-authorization headers appropriately.\x0d\n//\x0d\n// This function checks whether the request should be rewritten for proxying\x0d\n// and modifies the headers as well as req.path if necessary.\x0d\n// The handling of the proxy server connection is done in createConnection.\x0d\nfunction rewriteForProxiedHttp(req\x2C reqOptions) {\x0d\n  if (req._header) {\x0d\n    debug('request._header is already sent\x2C skipping rewriteForProxiedHttp'\x2C reqOptions);\x0d\n    return false;\x0d\n  }\x0d\n  const agent = req.agent;\x0d\n  if (!agent || !agent[kProxyConfig]) {\x0d\n    return false;\x0d\n  }\x0d\n  if ((reqOptions.protocol || agent.protocol) !== 'http:') {\x0d\n    return false;\x0d\n  }\x0d\n  // TODO(joyeecheung): cache this on the req or on the agent.\x0d\n  const shouldUseProxy = checkShouldUseProxy(agent[kProxyConfig]\x2C reqOptions);\x0d\n  debug(`rewriteForProxiedHttp should use proxy for ${reqOptions.host}:${reqOptions.port}:`\x2C shouldUseProxy);\x0d\n  if (!shouldUseProxy) {\x0d\n    return false;\x0d\n  }\x0d\n  // Add proxy headers.\x0d\n  const { auth\x2C href } = agent[kProxyConfig];\x0d\n  if (auth) {\x0d\n    req.setHeader('proxy-authorization'\x2C auth);\x0d\n  }\x0d\n  if (req.shouldKeepAlive) {\x0d\n    req.setHeader('proxy-connection'\x2C 'keep-alive');\x0d\n  } else {\x0d\n    req.setHeader('proxy-connection'\x2C 'close');\x0d\n  }\x0d\n\x0d\n  // Convert the path to absolute-form.\x0d\n  // https://datatracker.ietf.org/doc/html/rfc7230#section-5.3.2\x0d\n  const requestHost = req.getHeader('host') || 'localhost';\x0d\n  const requestBase = `http://${requestHost}`;\x0d\n  const requestURL = new URL(req.path\x2C requestBase);\x0d\n  if (reqOptions.port) {\x0d\n    requestURL.port = reqOptions.port;\x0d\n  }\x0d\n  req.path = requestURL.href;\x0d\n  debug(`updated request for HTTP proxy ${href} with ${req.path} `\x2C req[kOutHeaders]);\x0d\n  return true;\x0d\n};\x0d\n\x0d\nfunction ClientRequest(input\x2C options\x2C cb) {\x0d\n  OutgoingMessage.call(this);\x0d\n\x0d\n  if (typeof input === 'string') {\x0d\n    const urlStr = input;\x0d\n    input = urlToHttpOptions(new URL(urlStr));\x0d\n  } else if (isURL(input)) {\x0d\n    // url.URL instance\x0d\n    input = urlToHttpOptions(input);\x0d\n  } else {\x0d\n    cb = options;\x0d\n    options = input;\x0d\n    input = null;\x0d\n  }\x0d\n\x0d\n  if (typeof options === 'function') {\x0d\n    cb = options;\x0d\n    options = input || kEmptyObject;\x0d\n  } else {\x0d\n    options = ObjectAssign(input || {}\x2C options);\x0d\n  }\x0d\n\x0d\n  let agent = options.agent;\x0d\n  const defaultAgent = options._defaultAgent || Agent.globalAgent;\x0d\n  if (agent === false) {\x0d\n    agent = new defaultAgent.constructor();\x0d\n  } else if (agent === null || agent === undefin