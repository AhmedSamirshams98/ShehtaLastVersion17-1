script-source,241,node:internal/modules/esm/translators,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  JSONParse\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  ReflectApply\x2C\x0d\n  SafeArrayIterator\x2C\x0d\n  SafeMap\x2C\x0d\n  SafeSet\x2C\x0d\n  SafeWeakMap\x2C\x0d\n  StringPrototypeIncludes\x2C\x0d\n  StringPrototypeReplaceAll\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n  globalThis: { WebAssembly }\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  compileFunctionForCJSLoader\x2C\x0d\n} = internalBinding('contextify');\x0d\n\x0d\nconst { BuiltinModule } = require('internal/bootstrap/realm');\x0d\nconst assert = require('internal/assert');\x0d\nconst { readFileSync } = require('fs');\x0d\nconst { dirname\x2C extname } = require('path');\x0d\nconst {\x0d\n  assertBufferSource\x2C\x0d\n  loadBuiltinModule\x2C\x0d\n  stringify\x2C\x0d\n  stripBOM\x2C\x0d\n  urlToFilename\x2C\x0d\n} = require('internal/modules/helpers');\x0d\nconst { stripTypeScriptModuleTypes } = require('internal/modules/typescript');\x0d\nconst {\x0d\n  kIsCachedByESMLoader\x2C\x0d\n  Module: CJSModule\x2C\x0d\n  wrapModuleLoad\x2C\x0d\n  kModuleSource\x2C\x0d\n  kModuleExport\x2C\x0d\n  kModuleExportNames\x2C\x0d\n  findLongestRegisteredExtension\x2C\x0d\n  resolveForCJSWithHooks\x2C\x0d\n  loadSourceForCJSWithHooks\x2C\x0d\n  populateCJSExportsFromESM\x2C\x0d\n} = require('internal/modules/cjs/loader');\x0d\nconst { fileURLToPath\x2C pathToFileURL\x2C URL } = require('internal/url');\x0d\nlet debug = require('internal/util/debuglog').debuglog('esm'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst { emitExperimentalWarning\x2C kEmptyObject\x2C setOwnProperty\x2C isWindows } = require('internal/util');\x0d\nconst {\x0d\n  ERR_INVALID_RETURN_PROPERTY_VALUE\x2C\x0d\n  ERR_UNKNOWN_BUILTIN_MODULE\x2C\x0d\n} = require('internal/errors').codes;\x0d\nconst { maybeCacheSourceMap } = require('internal/source_map/source_map_cache');\x0d\nconst moduleWrap = internalBinding('module_wrap');\x0d\nconst { ModuleWrap } = moduleWrap;\x0d\n\x0d\n// Lazy-loading to avoid circular dependencies.\x0d\nlet getSourceSync;\x0d\n/**\x0d\n * @param {Parameters<typeof import('./load').getSourceSync>[0]} url\x0d\n * @returns {ReturnType<typeof import('./load').getSourceSync>}\x0d\n */\x0d\nfunction getSource(url) {\x0d\n  getSourceSync ??= require('internal/modules/esm/load').getSourceSync;\x0d\n  return getSourceSync(url);\x0d\n}\x0d\n\x0d\n/** @type {import('deps/cjs-module-lexer/lexer.js').parse} */\x0d\nlet cjsParse;\x0d\n/**\x0d\n * Initializes the CommonJS module lexer parser using the JavaScript version.\x0d\n * TODO(joyeecheung): Use `require('internal/deps/cjs-module-lexer/dist/lexer').initSync()`\x0d\n * when cjs-module-lexer 1.4.0 is rolled in.\x0d\n */\x0d\nfunction initCJSParseSync() {\x0d\n  if (cjsParse === undefined) {\x0d\n    cjsParse = require('internal/deps/cjs-module-lexer/lexer').parse;\x0d\n  }\x0d\n}\x0d\n\x0d\nconst translators = new SafeMap();\x0d\nexports.translators = translators;\x0d\n\x0d\n/**\x0d\n * Converts a URL to a file path if the URL protocol is 'file:'.\x0d\n * @param {string} url - The URL to convert.\x0d\n * @returns {string|URL}\x0d\n */\x0d\nfunction errPath(url) {\x0d\n  const parsed = new URL(url);\x0d\n  if (parsed.protocol === 'file:') {\x0d\n    return fileURLToPath(parsed);\x0d\n  }\x0d\n  return url;\x0d\n}\x0d\n\x0d\n// Strategy for loading a standard JavaScript module.\x0d\ntranslators.set('module'\x2C function moduleStrategy(url\x2C translateContext\x2C parentURL) {\x0d\n  let { source } = translateContext;\x0d\n  const isMain = (parentURL === undefined);\x0d\n  assertBufferSource(source\x2C true\x2C 'load');\x0d\n  source = stringify(source);\x0d\n  debug(`Translating StandardModule ${url}`\x2C translateContext);\x0d\n  const { compileSourceTextModule } = require('internal/modules/esm/utils');\x0d\n  const context = isMain ? { isMain } : undefined;\x0d\n  const module = compileSourceTextModule(url\x2C source\x2C this\x2C context);\x0d\n  return module;\x0d\n});\x0d\n\x0d\n/**\x0d\n * Loads a CommonJS module via the ESM Loader sync CommonJS translator.\x0d\n * This translator creates its own version of the `require` function passed into CommonJS modules.\x0d\n * Any monkey patches applied to the CommonJS Loader will not affect this module.\x0d\n * Any `require` calls in this module will load all children in the same way.\x0d\n * @param {import('internal/modules/cjs/loader').Module} module - The module to load.\x0d\n * @param {string} source - The source code of the module.\x0d\n * @param {string} url - The URL of the module.\x0d\n * @param {string} filename - The filename of the module.\x0d\n * @param {boolean} isMain - Whether the module is the entrypoint\x0d\n */\x0d\nfunction loadCJSModule(module\x2C source\x2C url\x2C filename\x2C isMain) {\x0d\n  const compileResult = compileFunctionForCJSLoader(source\x2C filename\x2C false /* is_sea_main */\x2C false);\x0d\n\x0d\n  const { function: compiledWrapper\x2C sourceMapURL\x2C sourceURL } = compileResult;\x0d\n  // Cache the source map for the cjs module if present.\x0d\n  if (sourceMapURL) {\x0d\n    maybeCacheSourceMap(url\x2C source\x2C module\x2C false\x2C sourceURL\x2C sourceMapURL);\x0d\n  }\x0d\n\x0d\n  const cascadedLoader = require('internal/modules/esm/loader').getOrInitializeCascadedLoader();\x0d\n  const __dirname = dirname(filename);\x0d\n  // eslint-disable-next-line func-name-matching\x2Cfunc-style\x0d\n  const requireFn = function require(specifier) {\x0d\n    let importAttributes = kEmptyObject;\x0d\n    if (!StringPrototypeStartsWith(specifier\x2C 'node:') && !BuiltinModule.normalizeRequirableId(specifier)) {\x0d\n      // TODO: do not depend on the monkey-patchable CJS loader here.\x0d\n      const path = CJSModule._resolveFilename(specifier\x2C module);\x0d\n      switch (extname(path)) {\x0d\n        