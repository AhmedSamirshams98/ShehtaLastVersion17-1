on];\x0d\n  if (!session) return;\x0d\n  switch (name) {\x0d\n    case 'priority':\x0d\n      session[kNativeFields][kSessionPriorityListenerCount]--;\x0d\n      break;\x0d\n    case 'frameError':\x0d\n      session[kNativeFields][kSessionFrameErrorListenerCount]--;\x0d\n      break;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onPing(payload) {\x0d\n  const session = this[kOwner];\x0d\n  if (session.destroyed)\x0d\n    return;\x0d\n  session[kUpdateTimer]();\x0d\n  debugSessionObj(session\x2C 'new ping received');\x0d\n  session.emit('ping'\x2C payload);\x0d\n}\x0d\n\x0d\n// Called when the stream is closed either by sending or receiving an\x0d\n// RST_STREAM frame\x2C or through a natural end-of-stream.\x0d\n// If the writable and readable sides of the stream are still open at this\x0d\n// point\x2C close them. If there is an open fd for file send\x2C close that also.\x0d\n// At this point the underlying node::http2:Http2Stream handle is no\x0d\n// longer usable so destroy it also.\x0d\nfunction onStreamClose(code) {\x0d\n  const stream = this[kOwner];\x0d\n  if (!stream || stream.destroyed)\x0d\n    return false;\x0d\n\x0d\n  debugStreamObj(\x0d\n    stream\x2C 'closed with code %d\x2C closed %s\x2C readable %s'\x2C\x0d\n    code\x2C stream.closed\x2C stream.readable\x2C\x0d\n  );\x0d\n\x0d\n  if (!stream.closed)\x0d\n    closeStream(stream\x2C code\x2C kNoRstStream);\x0d\n\x0d\n  stream[kState].fd = -1;\x0d\n  // Defer destroy we actually emit end.\x0d\n  if (!stream.readable || code !== NGHTTP2_NO_ERROR) {\x0d\n    // If errored or ended\x2C we can destroy immediately.\x0d\n    stream.destroy();\x0d\n  } else {\x0d\n    // Wait for end to destroy.\x0d\n    stream.on('end'\x2C stream[kMaybeDestroy]);\x0d\n    // Push a null so the stream can end whenever the client consumes\x0d\n    // it completely.\x0d\n    stream.push(null);\x0d\n\x0d\n    // If the user hasn't tried to consume the stream (and this is a server\x0d\n    // session) then just dump the incoming data so that the stream can\x0d\n    // be destroyed.\x0d\n    if (stream[kSession][kType] === NGHTTP2_SESSION_SERVER &&\x0d\n        !stream[kState].didRead &&\x0d\n        stream.readableFlowing === null)\x0d\n      stream.resume();\x0d\n    else\x0d\n      stream.read(0);\x0d\n  }\x0d\n  return true;\x0d\n}\x0d\n\x0d\n// Called when the remote peer settings have been updated.\x0d\n// Resets the cached settings.\x0d\nfunction onSettings() {\x0d\n  const session = this[kOwner];\x0d\n  if (session.destroyed)\x0d\n    return;\x0d\n  session[kUpdateTimer]();\x0d\n  debugSessionObj(session\x2C 'new settings received');\x0d\n  session[kRemoteSettings] = undefined;\x0d\n  session.emit('remoteSettings'\x2C session.remoteSettings);\x0d\n}\x0d\n\x0d\n// If the stream exists\x2C an attempt will be made to emit an event\x0d\n// on the stream object itself. Otherwise\x2C forward it on to the\x0d\n// session (which may\x2C in turn\x2C forward it on to the server)\x0d\nfunction onPriority(id\x2C parent\x2C weight\x2C exclusive) {\x0d\n  const session = this[kOwner];\x0d\n  if (session.destroyed)\x0d\n    return;\x0d\n  debugStream(id\x2C session[kType]\x2C\x0d\n              'priority [parent: %d\x2C weight: %d\x2C exclusive: %s]'\x2C\x0d\n              parent\x2C weight\x2C exclusive);\x0d\n  const emitter = session[kState].streams.get(id) || session;\x0d\n  if (!emitter.destroyed) {\x0d\n    emitter[kUpdateTimer]();\x0d\n    emitter.emit('priority'\x2C id\x2C parent\x2C weight\x2C exclusive);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Called by the native layer when an error has occurred sending a\x0d\n// frame. This should be exceedingly rare.\x0d\nfunction onFrameError(id\x2C type\x2C code) {\x0d\n  const session = this[kOwner];\x0d\n  if (session.destroyed)\x0d\n    return;\x0d\n  debugSessionObj(session\x2C 'error sending frame type %d on stream %d\x2C code: %d'\x2C\x0d\n                  type\x2C id\x2C code);\x0d\n\x0d\n  const stream = session[kState].streams.get(id);\x0d\n  const emitter = 