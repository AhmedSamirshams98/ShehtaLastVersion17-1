script-source,181,node:internal/js_stream_socket,'use strict';\x0d\n\x0d\nconst {\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst { setImmediate } = require('timers');\x0d\nconst assert = require('internal/assert');\x0d\nconst { Socket } = require('net');\x0d\nconst { JSStream } = internalBinding('js_stream');\x0d\nconst uv = internalBinding('uv');\x0d\nlet debug = require('internal/util/debuglog').debuglog(\x0d\n  'stream_socket'\x2C\x0d\n  (fn) => {\x0d\n    debug = fn;\x0d\n  }\x2C\x0d\n);\x0d\nconst { owner_symbol } = require('internal/async_hooks').symbols;\x0d\nconst { ERR_STREAM_WRAP } = require('internal/errors').codes;\x0d\nconst { kBoundSession } = require('internal/stream_base_commons');\x0d\n\x0d\nconst kCurrentWriteRequest = Symbol('kCurrentWriteRequest');\x0d\nconst kCurrentShutdownRequest = Symbol('kCurrentShutdownRequest');\x0d\nconst kPendingShutdownRequest = Symbol('kPendingShutdownRequest');\x0d\nconst kPendingClose = Symbol('kPendingClose');\x0d\n\x0d\nfunction isClosing() { return this[owner_symbol].isClosing(); }\x0d\n\x0d\nfunction onreadstart() { return this[owner_symbol].readStart(); }\x0d\n\x0d\nfunction onreadstop() { return this[owner_symbol].readStop(); }\x0d\n\x0d\nfunction onshutdown(req) { return this[owner_symbol].doShutdown(req); }\x0d\n\x0d\nfunction onwrite(req\x2C bufs) { return this[owner_symbol].doWrite(req\x2C bufs); }\x0d\n\x0d\n/* This class serves as a wrapper for when the C++ side of Node wants access\x0d\n * to a standard JS stream. For example\x2C TLS or HTTP do not operate on network\x0d\n * resources conceptually\x2C although that is the common case and what we are\x0d\n * optimizing for; in theory\x2C they are completely composable and can work with\x0d\n * any stream resource they see.\x0d\n *\x0d\n * For the common case\x2C i.e. a TLS socket wrapping around a net.Socket\x2C we\x0d\n * can skip going through the JS layer and let TLS access the raw C++ handle\x0d\n * of a net.Socket. The flipside of this is t