script-source,292,node:internal/webstreams/util,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayBufferPrototypeGetByteLength\x2C\x0d\n  ArrayBufferPrototypeGetDetached\x2C\x0d\n  ArrayBufferPrototypeSlice\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypeShift\x2C\x0d\n  AsyncIteratorPrototype\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  MathMax\x2C\x0d\n  NumberIsNaN\x2C\x0d\n  PromisePrototypeThen\x2C\x0d\n  ReflectGet\x2C\x0d\n  Symbol\x2C\x0d\n  SymbolAsyncIterator\x2C\x0d\n  SymbolIterator\x2C\x0d\n  Uint8Array\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_ARG_NOT_ITERABLE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_STATE\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  copyArrayBuffer\x2C\x0d\n} = internalBinding('buffer');\x0d\n\x0d\nconst {\x0d\n  inspect\x2C\x0d\n} = require('util');\x0d\n\x0d\nconst {\x0d\n  constants: {\x0d\n    kPending\x2C\x0d\n  }\x2C\x0d\n  getPromiseDetails\x2C\x0d\n} = internalBinding('util');\x0d\n\x0d\nconst assert = require('internal/assert');\x0d\n\x0d\nconst {\x0d\n  validateFunction\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst kState = Symbol('kState');\x0d\nconst kType = Symbol('kType');\x0d\n\x0d\nconst AsyncIterator = {\x0d\n  __proto__: AsyncIteratorPrototype\x2C\x0d\n  next: undefined\x2C\x0d\n  return: undefined\x2C\x0d\n};\x0d\n\x0d\nfunction extractHighWaterMark(value\x2C defaultHWM) {\x0d\n  if (value === undefined) return defaultHWM;\x0d\n  value = +value;\x0d\n  if (typeof value !== 'number' ||\x0d\n      NumberIsNaN(value) ||\x0d\n      value < 0)\x0d\n    throw new ERR_INVALID_ARG_VALUE.RangeError('strategy.highWaterMark'\x2C value);\x0d\n  return value;\x0d\n}\x0d\n\x0d\nfunction extractSizeAlgorithm(size) {\x0d\n  if (size === undefined) return () => 1;\x0d\n  validateFunction(size\x2C 'strategy.size');\x0d\n  return size;\x0d\n}\x0d\n\x0d\nfunction customInspect(depth\x2C options\x2C name\x2C data) {\x0d\n  if (depth < 0)\x0d\n    return this;\x0d\n\x0d\n  const opts = {\x0d\n    ...options\x2C\x0d\n    depth: options.depth == null ? null : options.depth - 1\x2C\x0d\n  };\x0d\n\x0d\n  return `${name} ${inspect(data\x2C opts)}`;\x0d\n}\x0d\n\x0d\n// These are defensive to work around the possibility that\x0d\n// the buffer\x2C byteLength\x2C and byteOffset properties on\x0d\n// ArrayBuffer and ArrayBufferView's may have been tampered with.\x0d\n\x0d\nfunction ArrayBufferViewGetBuffer(view) {\x0d\n  return ReflectGet(view.constructor.prototype\x2C 'buffer'\x2C view);\x0d\n}\x0d\n\x0d\nfunction ArrayBufferViewGetByteLength(view) {\x0d\n  return ReflectGet(view.constructor.prototype\x2C 'byteLength'\x2C view);\x0d\n}\x0d\n\x0d\nfunction ArrayBufferViewGetByteOffset(view) {\x0d\n  return ReflectGet(view.constructor.prototype\x2C 'byteOffset'\x2C view);\x0d\n}\x0d\n\x0d\nfunction cloneAsUint8Array(view) {\x0d\n  const buffer = ArrayBufferViewGetBuffer(view);\x0d\n  const byteOffset = ArrayBufferViewGetByteOffset(view);\x0d\n  const byteLength = ArrayBufferViewGetByteLength(view);\x0d\n  return new Uint8Array(\x0d\n    ArrayBufferPrototypeSlice(buffer\x2C byteOffset\x2C byteOffset + byteLength)\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\nfunction canCopyArrayBuffer(toBuffer\x2C toIndex\x2C fromBuffer\x2C fromIndex\x2C count) {\x0d\n  return toBuffer !== fromBuffer &&\x0d\n    !ArrayBufferPrototypeGetDetached(toBuffer) &&\x0d\n    !ArrayBufferPrototypeGetDetached(fromBuffer) &&\x0d\n    toIndex + count <= ArrayBufferPrototypeGetByteLength(toBuffer) &&\x0d\n    fromIndex + count <= ArrayBufferPrototypeGetByteLength(fromBuffer);\x0d\n}\x0d\n\x0d\nfunction isBrandCheck(brand) {\x0d\n  return (value) => {\x0d\n    return value != null &&\x0d\n           value[kState] !== undefined &&\x0d\n           value[kType] === brand;\x0d\n  };\x0d\n}\x0d\n\x0d\nfunction dequeueValue(controller) {\x0d\n  assert(controller[kState].queue !== undefined);\x0d\n  assert(controller[kState].queueTotalSize !== undefined);\x0d\n  assert(controller[kState].queue.length);\x0d\n  const {\x0d\n    value\x2C\x0d\n    size\x2C\x0d\n  } = ArrayPrototypeShift(controller[kState].queue);\x0d\n  controller[kState].queueTotalSize =\x0d\n    MathMax(0\x2C controller[kState].queueTotalSize - size);\x0d\n  return value;\x0d\n}\x0d\n\x0d\nfunction resetQueue(controller) {\x0d\n  assert(controller[kState].queue !== undefined);\x0d\n  assert(controller[kState].queueTotalSize !== undefined);\x0d\n  controller[kState].queue = [];\x0d\n  controller[kState].queueTotalSize = 0;\x0d\n}\x0d\n\x0d\nfunction peekQueueValue(controller) {\x0d\n  assert(controller[kState].queue !== undefined);\x0d\n  assert(controller[kState].queueTotalSize !== undefined);\x0d\n  assert(controller[kState].queue.length);\x0d\n  return controller[kState].queue[0].value;\x0d\n}\x0d\n\x0d\nfunction enqueueValueWithSize(controller\x2C value\x2C size) {\x0d\n  assert(controller[kState].queue !== undefined);\x0d\n  assert(controller[kState].queueTotalSize !== undefined);\x0d\n  size = +size;\x0d\n  if (typeof size !== 'number' ||\x0d\n      size < 0 ||\x0d\n      NumberIsNaN(size) ||\x0d\n      size === Infinity) {\x0d\n    throw new ERR_INVALID_ARG_VALUE.RangeError('size'\x2C size);\x0d\n  }\x0d\n  ArrayPrototypePush(controller[kState].queue\x2C { value\x2C size });\x0d\n  controller[kState].queueTotalSize += size;\x0d\n}\x0d\n\x0d\n// This implements "invoke a callback function type" for callback functions that return a promise.\x0d\n// See https://webidl.spec.whatwg.org/#es-invoking-callback-functions\x0d\nasync function invokePromiseCallback(fn\x2C thisArg\x2C ...args) {\x0d\n  return FunctionPrototypeCall(fn\x2C thisArg\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction createPromiseCallback(name\x2C fn\x2C thisArg) {\x0d\n  validateFunction(fn\x2C name);\x0d\n  return (...args) => invokePromiseCallback(fn\x2C thisArg\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction isPromisePending(promise) {\x0d\n  if (promise === undefined) return false;\x0d\n  const details = getPromiseDetails(promise);\x0d\n  return details?.[0] === kPending;\x0d\n}\x0d\n\x0d\nfunction setPromiseHandled(promise) {\x0d\n  // Alternatively\x2C we could use the native API\x0d\n  // MarkAsHandled\x2C but this avoids the extra boundary cross\x0d\n  // and is hopefully faster at the cost of an extra Promise\x0d\n  // allocation.\x0d\n  PromisePrototypeThen(promise\x2C () => {}\x2C () => {});\x0d\n}\x0d\n\x0d\nasync function nonOpFlush() {}\x0d\n\x0d\nfunction nonOpStart() {}\x0d\n\x0d\nasync function nonOpPull() {}\x0d\n\x0d\nasync function nonOpCancel() {}\x0d\n\x0d\nasync function nonOpWrite() {}\x0d\n\x0d\nlet transfer;\x0d\nfunction lazyTransfer() {\x0d\n  if (transfer === undefined)\x0d\n    transfer = require('internal/webstreams/transfer');\x0d\n  return transfer;\x0d\n}\x0d\n\x0d\nfunction createAsyncFromSyncIterator(syncIteratorRecord) {\x0d\n  const syncIterable = {\x0d\n    [SymbolIterator]: () => syncIteratorRecord.iterator\x2C\x0d\n  };\x0d\n\x0d\n  const asyncIterator = (async function* () {\x0d\n    return yield* syncIterable;\x0d\n  }());\x0d\n\x0d\n  const nextMethod = asyncIterator.next;\x0d\n  return { iterator: asyncIterator\x2C nextMethod\x2C done: false };\x0d\n}\x0d\n\x0d\n// Refs: https://tc39.es/ecma262/#sec-getiterator\x0d\nfunction getIterator(obj\x2C kind = 'sync'\x2C method) {\x0d\n  if (method === undefined) {\x0d\n    if (kind === 'async') {\x0d\n      method = obj[SymbolAsyncIterator];\x0d\n      if (method == null) {\x0d\n        const syncMethod = obj[SymbolIterator];\x0d\n\x0d\n        if (syncMethod === undefined) {\x0d\n          throw new ERR_ARG_NOT_ITERABLE(obj);\x0d\n        }\x0d\n\x0d\n        const syncIteratorRecord = getIterator(obj\x2C 'sync'\x2C syncMethod);\x0d\n        return createAsyncFromSyncIterator(syncIteratorRecord);\x0d\n      }\x0d\n    } else {\x0d\n      method = obj[SymbolIterator];\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (method === undefined) {\x0d\n    throw new ERR_ARG_NOT_ITERABLE(obj);\x0d\n  }\x0d\n\x0d\n  const iterator = FunctionPrototypeCall(method\x2C obj);\x0d\n  if (typeof iterator !== 'object' || iterator === null) {\x0d\n    throw new ERR_INVALID_STATE.TypeError('The iterator method must return an object');\x0d\n  }\x0d\n  const nextMethod = iterator.next;\x0d\n  return { iterator\x2C nextMethod\x2C done: false };\x0d\n}\x0d\n\x0d\nfunction iteratorNext(iteratorRecord\x2C value) {\x0d\n  let result;\x0d\n  if (value === undefined) {\x0d\n    result = FunctionPrototypeCall(iteratorRecord.nextMethod\x2C iteratorRecord.iterator);\x0d\n  } else {\x0d\n    result = FunctionPrototypeCall(iteratorRecord.nextMethod\x2C iteratorRecord.iterator\x2C [value]);\x0d\n  }\x0d\n  if (typeof result !== 'object' || result === null) {\x0d\n    throw new ERR_INVALID_STATE.TypeError('The iterator.next() method must return an object');\x0d\n  }\x0d\n  return result;\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  ArrayBufferViewGetBuffer\x2C\x0d\n  ArrayBufferViewGetByteLength\x2C\x0d\n  ArrayBufferViewGetByteOffset\x2C\x0d\n  AsyncIterator\x2C\x0d\n  canCopyArrayBuffer\x2C\x0d\n  createPromiseCallback\x2C\x0d\n  cloneAsUint8Array\x2C\x0d\n  copyArrayBuffer\x2C\x0d\n  customInspect\x2C\x0d\n  dequeueValue\x2C\x0d\n  enqueueValueWithSize\x2C\x0d\n  extractHighWaterMark\x2C\x0d\n  extractSizeAlgorithm\x2C\x0d\n  lazyTransfer\x2C\x0d\n  invokePromiseCallback\x2C\x0d\n  isBrandCheck\x2C\x0d\n  isPromisePending\x2C\x0d\n  peekQueueValue\x2C\x0d\n  resetQueue\x2C\x0d\n  setPromiseHandled\x2C\x0d\n  nonOpCancel\x2C\x0d\n  nonOpFlush\x2C\x0d\n  nonOpPull\x2C\x0d\n  nonOpStart\x2C\x0d\n  nonOpWrite\x2C\x0d\n  getIterator\x2C\x0d\n  iteratorNext\x2C\x0d\n  kType\x2C\x0d\n  kState\x2C\x0d\n};\x0d\n
