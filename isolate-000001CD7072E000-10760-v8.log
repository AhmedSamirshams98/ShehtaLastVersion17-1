script-source,273,node:internal/errors/error_source,'use strict';\x0d\n\x0d\nconst {\x0d\n  FunctionPrototypeBind\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  getErrorSourcePositions\x2C\x0d\n} = internalBinding('errors');\x0d\nconst {\x0d\n  getSourceMapsSupport\x2C\x0d\n  findSourceMap\x2C\x0d\n  getSourceLine\x2C\x0d\n} = require('internal/source_map/source_map_cache');\x0d\n\x0d\n/**\x0d\n * Get the source location of an error. If source map is enabled\x2C resolve the source location\x0d\n * based on the source map.\x0d\n *\x0d\n * The `error.stack` must not have been accessed. The resolution is based on the structured\x0d\n * error stack data.\x0d\n * @param {Error|object} error An error object\x2C or an object being invoked with ErrorCaptureStackTrace\x0d\n * @returns {{sourceLine: string\x2C startColumn: number}|undefined}\x0d\n */\x0d\nfunction getErrorSourceLocation(error) {\x0d\n  const pos = getErrorSourcePositions(error);\x0d\n  const {\x0d\n    sourceLine\x2C\x0d\n    scriptResourceName\x2C\x0d\n    lineNumber\x2C\x0d\n    startColumn\x2C\x0d\n  } = pos;\x0d\n\x0d\n  // Source map is not enabled. Return the source line directly.\x0d\n  if (!getSourceMapsSupport().enabled) {\x0d\n    return { sourceLine\x2C startColumn };\x0d\n  }\x0d\n\x0d\n  const sm = findSourceMap(scriptResourceName);\x0d\n  if (sm === undefined) {\x0d\n    return;\x0d\n  }\x0d\n  const {\x0d\n    originalLine\x2C\x0d\n    originalColumn\x2C\x0d\n    originalSource\x2C\x0d\n  } = sm.findEntry(lineNumber - 1\x2C startColumn);\x0d\n  const originalSourceLine = getSourceLine(sm\x2C originalSource\x2C originalLine\x2C originalColumn);\x0d\n\x0d\n  if (!originalSourceLine) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  return {\x0d\n    sourceLine: originalSourceLine\x2C\x0d\n    startColumn: originalColumn\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\nconst memberAccessTokens = [ '.'\x2C '?.'\x2C '['\x2C ']' ];\x0d\nconst memberNameTokens = [ 'name'\x2C 'string'\x2C 'num' ];\x0d\nlet tokenizer;\x0d\n/**\x0d\n * Get the first expression in a code string at the startColumn.\x0d\n * @param {string} code source code line\x0d\n * @param {number} startColumn which column the error is constructed\x0d\n * @returns {string}\x0d\n */\x0d\nfunction getFirstExpression(code\x2C startColumn) {\x0d\n  // Lazy load acorn.\x0d\n  if (tokenizer === undefined) {\x0d\n    const Parser = require('internal/deps/acorn/acorn/dist/acorn').Parser;\x0d\n    tokenizer = FunctionPrototypeBind(Parser.tokenizer\x2C Parser);\x0d\n  }\x0d\n\x0d\n  let lastToken;\x0d\n  let firstMemberAccessNameToken;\x0d\n  let terminatingCol;\x0d\n  let parenLvl = 0;\x0d\n  // Tokenize the line to locate the expression at the startColumn.\x0d\n  // The source line may be an incomplete JavaScript source\x2C so do not parse the source line.\x0d\n  for (const token of tokenizer(code\x2C { ecmaVersion: 'latest' })) {\x0d\n    // Peek before the startColumn.\x0d\n    if (token.start < startColumn) {\x0d\n      // There is a semicolon. This is a statement before the startColumn\x2C so reset the memo.\x0d\n      if (token.type.label === ';') {\x0d\n        firstMemberAccessNameToken = null;\x0d\n        continue;\x0d\n      }\x0d\n      // Try to memo the member access expressions before the startColumn\x2C so that the\x0d\n      // returned source code contains more info:\x0d\n      //   assert.ok(value)\x0d\n      //          ^ startColumn\x0d\n      // The member expression can also be like\x0d\n      //   assert['ok'](value) or assert?.ok(value)\x0d\n      //               ^ startColumn      ^ startColumn\x0d\n      if (memberAccessTokens.includes(token.type.label) && lastToken?.type.label === 'name') {\x0d\n        // First member access name token must be a 'name'.\x0d\n        firstMemberAccessNameToken ??= lastToken;\x0d\n      } else if (!memberAccessTokens.includes(token.type.label) &&\x0d\n        !memberNameTokens.includes(token.type.label)) {\x0d\n        // Reset the memo if it is not a simple member access.\x0d\n        // For example: assert[(() => 'ok')()](value)\x0d\n        //                                    ^ startColumn\x0d\n        firstMemberAccessNameToken = null;\x0d\n      }\x0d\n      lastToken = token;\x0d\n      continue;\x0d\n    }\x0d\n    // Now after the startColumn\x2C this must be an expression.\x0d\n    if (token.type.label === '(') {\x0d\n      parenLvl++;\x0d\n      continue;\x0d\n    }\x0d\n    if (token.type.label === ')') {\x0d\n      parenLvl--;\x0d\n      if (parenLvl === 0) {\x0d\n        // A matched closing parenthesis found after the startColumn\x2C\x0d\n        // terminate here. Include the token.\x0d\n        //   (assert.ok(false)\x2C assert.ok(true))\x0d\n        //           ^ startColumn\x0d\n        terminatingCol = token.start + 1;\x0d\n        break;\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    if (token.type.label === ';') {\x0d\n      // A semicolon found after the startColumn\x2C terminate here.\x0d\n      //   assert.ok(false); assert.ok(true));\x0d\n      //          ^ startColumn\x0d\n      terminatingCol = token;\x0d\n      break;\x0d\n    }\x0d\n    // If no semicolon found after the startColumn. The string after the\x0d\n    // startColumn must be the expression.\x0d\n    //   assert.ok(false)\x0d\n    //          ^ startColumn\x0d\n  }\x0d\n  const start = firstMemberAccessNameToken?.start ?? startColumn;\x0d\n  return StringPrototypeSlice(code\x2C start\x2C terminatingCol);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Get the source expression of an error. If source map is enabled\x2C resolve the source location\x0d\n * based on the source map.\x0d\n *\x0d\n * The `error.stack` must not have been accessed\x2C or the source location may be incorrect. The\x0d\n * resolution is based on the structured error stack data.\x0d\n * @param {Error|object} error An error object\x2C or an object being invoked with ErrorCaptureStackTrace\x0d\n * @returns {string|undefined}\x0d\n */\x0d\nfunction getErrorSourceExpression(error) {\x0d\n  const loc = getErrorSourceLocation(error);\x0d\n  if (loc === undefined) {\x0d\n    return;\x0d\n  }\x0d\n  const { sourceLine\x2C startColumn } = loc;\x0d\n  return getFirstExpression(sourceLine\x2C startColumn);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  getErrorSourceLocation\x2C\x0d\n  getErrorSourceExpression\x2C\x0d\n};\x0d\n
